table 'P&L View'
	lineageTag: 2033718c-78ab-5349-8fdc-557fb750d507

	calculationGroup
		precedence: 10

		calculationItem Actual =
				
				CALCULATE ( SELECTEDMEASURE ( ), 'Financials'[Scenario] = "Actual" )

			formatStringDefinition = Fmt.PL ( SELECTEDMEASURE ( ), SELECTEDMEASUREFORMATSTRING ( ) )

		calculationItem LY =
				
				CALCULATE (
				    CALCULATE ( SELECTEDMEASURE ( ), 'Financials'[Scenario] = "Actual" ),
				    DATEADD ( 'DimDate'[Date], -1, YEAR )
				)

			formatStringDefinition = Fmt.PL ( SELECTEDMEASURE ( ), SELECTEDMEASUREFORMATSTRING ( ) )

		calculationItem 'vs LY' =
				
				VAR __A =
				    CALCULATE ( SELECTEDMEASURE ( ), 'Financials'[Scenario] = "Actual" )
				VAR __B =
				    CALCULATE (
				        CALCULATE ( SELECTEDMEASURE ( ), 'Financials'[Scenario] = "Actual" ),
				        DATEADD ( 'DimDate'[Date], -1, YEAR )
				    )
				RETURN
				    __A - __B

			formatStringDefinition = Fmt.PL ( SELECTEDMEASURE ( ), SELECTEDMEASUREFORMATSTRING ( ) )

		calculationItem 'vs LY %' =
				
				VAR __A =
				    CALCULATE ( SELECTEDMEASURE ( ), 'Financials'[Scenario] = "Actual" )
				VAR __B =
				    CALCULATE (
				        CALCULATE ( SELECTEDMEASURE ( ), 'Financials'[Scenario] = "Actual" ),
				        DATEADD ( 'DimDate'[Date], -1, YEAR )
				    )
				RETURN
				    DIVIDE ( __A - __B, __B )

			formatStringDefinition = "0.0%;(0.0%)"

		calculationItem Budget =
				
				CALCULATE ( SELECTEDMEASURE ( ), 'Financials'[Scenario] = "Budget" )

			formatStringDefinition = Fmt.PL ( SELECTEDMEASURE ( ), SELECTEDMEASUREFORMATSTRING ( ) )

