	/// Bridge reuse: one line, one filter on the bridge's Line column, no SWITCH.
	measure 'Line Total Cost of Sales' =
			
			CALCULATE ( [P&L Actual], 'P&L Lines'[Line] = "Total Cost of Sales" )
		formatString: $#,##0
		displayFolder: 05 Hybrid (field parameter)
		lineageTag: 84e71f8a-b45e-4e2b-bbd9-f02b83e56925

	/// Bridge reuse: one line, one filter on the bridge's Line column, no SWITCH.
	measure 'Line Total Operating Expenses' =
			
			CALCULATE ( [P&L Actual], 'P&L Lines'[Line] = "Total Operating Expenses" )
		formatString: $#,##0
		displayFolder: 05 Hybrid (field parameter)
		lineageTag: a2cd1a3a-1cde-415a-ac7d-d553cb779bfc

	/// A line no account can express, so just a normal measure.
	measure 'Hybrid Income per Store' =
			
			DIVIDE (
			    [Total Income $],
			    DISTINCTCOUNT ( 'Stores'[Store] )
			)
		formatString: $#,##0,,.0"M"
		displayFolder: 05 Hybrid (field parameter)
		lineageTag: ddd3d0f1-703e-4ae7-8453-5b4a76abcec4

	/// SWITCH counterpart of the calculation item 'Actual' -- 13 branches.
	measure 'Slow NM Actual' =
			
			VAR __Line = SELECTEDVALUE ( 'P&L Odd Rows'[Line] )
			RETURN
			SWITCH (
			    TRUE ( ),
			    __Line = "Total Income",
			        CALCULATE ( [NM Total Income], 'Financials'[Scenario] = "Actual" ),
			    __Line = "Total Cost of Sales",
			        CALCULATE ( [NM Total Cost of Sales], 'Financials'[Scenario] = "Actual" ),
			    __Line = "Gross Profit",
			        CALCULATE ( [NM Gross Profit], 'Financials'[Scenario] = "Actual" ),
			    __Line = "Total Operating Expenses",
			        CALCULATE ( [NM Total Operating Expenses], 'Financials'[Scenario] = "Actual" ),
			    __Line = "Net Profit",
			        CALCULATE ( [NM Net Profit], 'Financials'[Scenario] = "Actual" ),
			    __Line = "Gross Margin %",
			        CALCULATE ( [NM Gross Margin %], 'Financials'[Scenario] = "Actual" ),
			    __Line = "Net Margin %",
			        CALCULATE ( [NM Net Margin %], 'Financials'[Scenario] = "Actual" ),
			    __Line = "COGS % of Income",
			        CALCULATE ( [NM COGS % of Income], 'Financials'[Scenario] = "Actual" ),
			    __Line = "Opex % of Income",
			        CALCULATE ( [NM Opex % of Income], 'Financials'[Scenario] = "Actual" ),
			    __Line = "Income per Trading Store",
			        CALCULATE ( [NM Income per Trading Store], 'Financials'[Scenario] = "Actual" ),
			    __Line = "Net Profit per Trading Store",
			        CALCULATE ( [NM Net Profit per Trading Store], 'Financials'[Scenario] = "Actual" ),
			    __Line = "Income per Active Product",
			        CALCULATE ( [NM Income per Active Product], 'Financials'[Scenario] = "Actual" ),
			    __Line = "Trading Stores",
			        CALCULATE ( [NM Trading Stores], 'Financials'[Scenario] = "Actual" )
			)
		displayFolder: 07 Odd Rows SWITCH
		lineageTag: 7b0f37da-29df-584e-943a-1c8cd1bbfefe

		formatStringDefinition = VAR __Line = SELECTEDVALUE ( 'P&L Odd Rows'[Line] ) RETURN SWITCH ( TRUE ( ), __Line IN { "Gross Margin %", "Net Margin %", "COGS % of Income", "Opex % of Income" }, "0.0%;(0.0%)", __Line IN { "Trading Stores" }, "#,##0;(#,##0)", Fmt.Money ( [Slow NM Actual] ) )

	/// SWITCH counterpart of the calculation item 'LY' -- 13 branches.
	measure 'Slow NM LY' =
			
			VAR __Line = SELECTEDVALUE ( 'P&L Odd Rows'[Line] )
			RETURN
			SWITCH (
			    TRUE ( ),
			    __Line = "Total Income",
			        CALCULATE ( CALCULATE ( [NM Total Income], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
			    __Line = "Total Cost of Sales",
			        CALCULATE ( CALCULATE ( [NM Total Cost of Sales], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
			    __Line = "Gross Profit",
			        CALCULATE ( CALCULATE ( [NM Gross Profit], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
			    __Line = "Total Operating Expenses",
			        CALCULATE ( CALCULATE ( [NM Total Operating Expenses], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
			    __Line = "Net Profit",
			        CALCULATE ( CALCULATE ( [NM Net Profit], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
			    __Line = "Gross Margin %",
			        CALCULATE ( CALCULATE ( [NM Gross Margin %], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
			    __Line = "Net Margin %",
			        CALCULATE ( CALCULATE ( [NM Net Margin %], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
			    __Line = "COGS % of Income",
			        CALCULATE ( CALCULATE ( [NM COGS % of Income], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
			    __Line = "Opex % of Income",
			        CALCULATE ( CALCULATE ( [NM Opex % of Income], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
			    __Line = "Income per Trading Store",
			        CALCULATE ( CALCULATE ( [NM Income per Trading Store], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
			    __Line = "Net Profit per Trading Store",
			        CALCULATE ( CALCULATE ( [NM Net Profit per Trading Store], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
			    __Line = "Income per Active Product",
			        CALCULATE ( CALCULATE ( [NM Income per Active Product], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
			    __Line = "Trading Stores",
			        CALCULATE ( CALCULATE ( [NM Trading Stores], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) )
			)
		displayFolder: 07 Odd Rows SWITCH
		lineageTag: 16c79975-f6b3-59e1-ab4f-105b9dbdbc7a

		formatStringDefinition = VAR __Line = SELECTEDVALUE ( 'P&L Odd Rows'[Line] ) RETURN SWITCH ( TRUE ( ), __Line IN { "Gross Margin %", "Net Margin %", "COGS % of Income", "Opex % of Income" }, "0.0%;(0.0%)", __Line IN { "Trading Stores" }, "#,##0;(#,##0)", Fmt.Money ( [Slow NM LY] ) )

	/// SWITCH counterpart of the calculation item 'vs LY' -- 13 branches.
	measure 'Slow NM vs LY' =
			
			VAR __Line = SELECTEDVALUE ( 'P&L Odd Rows'[Line] )
			RETURN
			SWITCH (
			    TRUE ( ),
			    __Line = "Total Income",
			        CALCULATE ( [NM Total Income], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( CALCULATE ( [NM Total Income], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
			    __Line = "Total Cost of Sales",
			        CALCULATE ( [NM Total Cost of Sales], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( CALCULATE ( [NM Total Cost of Sales], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
			    __Line = "Gross Profit",
			        CALCULATE ( [NM Gross Profit], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( CALCULATE ( [NM Gross Profit], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
			    __Line = "Total Operating Expenses",
			        CALCULATE ( [NM Total Operating Expenses], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( CALCULATE ( [NM Total Operating Expenses], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
			    __Line = "Net Profit",
			        CALCULATE ( [NM Net Profit], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( CALCULATE ( [NM Net Profit], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
			    __Line = "Gross Margin %",
			        CALCULATE ( [NM Gross Margin %], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( CALCULATE ( [NM Gross Margin %], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
			    __Line = "Net Margin %",
			        CALCULATE ( [NM Net Margin %], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( CALCULATE ( [NM Net Margin %], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
			    __Line = "COGS % of Income",
			        CALCULATE ( [NM COGS % of Income], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( CALCULATE ( [NM COGS % of Income], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
			    __Line = "Opex % of Income",
