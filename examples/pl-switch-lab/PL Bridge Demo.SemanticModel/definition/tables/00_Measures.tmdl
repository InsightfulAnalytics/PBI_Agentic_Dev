	measure 'Slow Var % Value' =
			
			VAR __Line = SELECTEDVALUE('P&L Rows'[Line])
			RETURN
			Switch(True(),
			__Line = "    Retail Sales", format(([Actual Retail Sales] - [Budget Retail Sales]) / [Budget Retail Sales], "0.0%"),
			__Line = "    Wholesale Sales", format(([Actual Wholesale Sales] - [Budget Wholesale Sales]) / [Budget Wholesale Sales], "0.0%"),
