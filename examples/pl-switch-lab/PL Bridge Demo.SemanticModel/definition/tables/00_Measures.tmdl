	/// vs Last Year as a share of Last Year.
	measure 'P&L vs LY %' =
			
			DIVIDE ( [P&L vs LY], [P&L LY] )
		formatString: 0.0%;(0.0%)
		displayFolder: 01 Fast P&L (bridge)
		lineageTag: 77b0f560-823b-43e3-8a27-18e05f0da63d

	/// Actual year-to-date (DATESYTD over DimDate; scenario predicate only).
	measure 'P&L Actual YTD' =
			
			CALCULATE (
			    SUM ( 'Financials'[Amount] ),
			    'Financials'[Scenario] = "Actual",
			    DATESYTD ( 'DimDate'[Date] )
			)
		displayFolder: 01 Fast P&L (bridge)
		lineageTag: 5e088fb8-4a3f-4969-85cd-9bbd89484ed6

		formatStringDefinition = SWITCH(TRUE(), ABS([P&L Actual YTD]) >= 1000000, "$#,##0,,.0""M"";($#,##0,,.0""M"")", ABS([P&L Actual YTD]) >= 1000, "$#,##0,.0""K"";($#,##0,.0""K"")", "$#,##0;($#,##0)")

	/// Budget year-to-date (DATESYTD over DimDate; scenario predicate only).
	measure 'P&L Budget YTD' =
			
			CALCULATE (
			    SUM ( 'Financials'[Amount] ),
			    'Financials'[Scenario] = "Budget",
			    DATESYTD ( 'DimDate'[Date] )
			)
		displayFolder: 01 Fast P&L (bridge)
		lineageTag: 3adb4452-2dd8-444d-bbb2-fd68b0285baa

		formatStringDefinition = SWITCH(TRUE(), ABS([P&L Budget YTD]) >= 1000000, "$#,##0,,.0""M"";($#,##0,,.0""M"")", ABS([P&L Budget YTD]) >= 1000, "$#,##0,.0""K"";($#,##0,.0""K"")", "$#,##0;($#,##0)")

	/// Actual YTD minus Budget YTD.
	measure 'P&L Var YTD' =
			
			[P&L Actual YTD] - [P&L Budget YTD]
		displayFolder: 01 Fast P&L (bridge)
		lineageTag: e74827cf-7761-4e60-a16d-c0efce95d0a5

		formatStringDefinition = SWITCH(TRUE(), ABS([P&L Var YTD]) >= 1000000, "$#,##0,,.0""M"";($#,##0,,.0""M"")", ABS([P&L Var YTD]) >= 1000, "$#,##0,.0""K"";($#,##0,.0""K"")", "$#,##0;($#,##0)")

	/// YTD variance as a share of Budget YTD.
	measure 'P&L Var % YTD' =
			
			DIVIDE ( [P&L Var YTD], [P&L Budget YTD] )
		formatString: 0.0%;(0.0%)
		displayFolder: 01 Fast P&L (bridge)
		lineageTag: d475392d-e3fa-48df-a090-9df874f6bf33

	/// Actual YTD shifted back one year (time intelligence over DimDate).
	measure 'P&L LY YTD' =
			
			CALCULATE ( [P&L Actual YTD], DATEADD ( 'DimDate'[Date], -1, YEAR ) )
		displayFolder: 01 Fast P&L (bridge)
		lineageTag: bdfbf6f7-01a5-4529-9465-496c4c408ab6

		formatStringDefinition = SWITCH(TRUE(), ABS([P&L LY YTD]) >= 1000000, "$#,##0,,.0""M"";($#,##0,,.0""M"")", ABS([P&L LY YTD]) >= 1000, "$#,##0,.0""K"";($#,##0,.0""K"")", "$#,##0;($#,##0)")

	/// Actual YTD minus Last Year YTD.
	measure 'P&L vs LY YTD' =
			
			[P&L Actual YTD] - [P&L LY YTD]
		displayFolder: 01 Fast P&L (bridge)
		lineageTag: 3f02f9c0-0fac-4341-8498-d92bf89a23b2

		formatStringDefinition = SWITCH(TRUE(), ABS([P&L vs LY YTD]) >= 1000000, "$#,##0,,.0""M"";($#,##0,,.0""M"")", ABS([P&L vs LY YTD]) >= 1000, "$#,##0,.0""K"";($#,##0,.0""K"")", "$#,##0;($#,##0)")

	/// YTD vs Last Year as a share of Last Year YTD.
	measure 'P&L vs LY % YTD' =
			
			DIVIDE ( [P&L vs LY YTD], [P&L LY YTD] )
		formatString: 0.0%;(0.0%)
		displayFolder: 01 Fast P&L (bridge)
		lineageTag: 5050aa54-1795-424f-a513-408b3b8d4aea

	measure 'YTD Actual Value LY' =
			
			CALCULATE([YTD Actual Value], DATEADD('DimDate'[Date], -1, YEAR))
		displayFolder: 02 Slow P&L (SWITCH)
