			        DIVIDE ( CALCULATE ( [NM Gross Margin %], 'Financials'[Scenario] = "Actual", DATESYTD ( 'DimDate'[Date] ) ) - CALCULATE ( [NM Gross Margin %], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ), CALCULATE ( [NM Gross Margin %], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ) ),
			    __Line = "Net Margin %",
			        DIVIDE ( CALCULATE ( [NM Net Margin %], 'Financials'[Scenario] = "Actual", DATESYTD ( 'DimDate'[Date] ) ) - CALCULATE ( [NM Net Margin %], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ), CALCULATE ( [NM Net Margin %], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ) ),
			    __Line = "COGS % of Income",
			        DIVIDE ( CALCULATE ( [NM COGS % of Income], 'Financials'[Scenario] = "Actual", DATESYTD ( 'DimDate'[Date] ) ) - CALCULATE ( [NM COGS % of Income], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ), CALCULATE ( [NM COGS % of Income], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ) ),
			    __Line = "Opex % of Income",
			        DIVIDE ( CALCULATE ( [NM Opex % of Income], 'Financials'[Scenario] = "Actual", DATESYTD ( 'DimDate'[Date] ) ) - CALCULATE ( [NM Opex % of Income], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ), CALCULATE ( [NM Opex % of Income], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ) ),
			    __Line = "Income per Trading Store",
			        DIVIDE ( CALCULATE ( [NM Income per Trading Store], 'Financials'[Scenario] = "Actual", DATESYTD ( 'DimDate'[Date] ) ) - CALCULATE ( [NM Income per Trading Store], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ), CALCULATE ( [NM Income per Trading Store], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ) ),
			    __Line = "Net Profit per Trading Store",
			        DIVIDE ( CALCULATE ( [NM Net Profit per Trading Store], 'Financials'[Scenario] = "Actual", DATESYTD ( 'DimDate'[Date] ) ) - CALCULATE ( [NM Net Profit per Trading Store], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ), CALCULATE ( [NM Net Profit per Trading Store], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ) ),
			    __Line = "Income per Active Product",
			        DIVIDE ( CALCULATE ( [NM Income per Active Product], 'Financials'[Scenario] = "Actual", DATESYTD ( 'DimDate'[Date] ) ) - CALCULATE ( [NM Income per Active Product], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ), CALCULATE ( [NM Income per Active Product], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ) ),
			    __Line = "Trading Stores",
			        DIVIDE ( CALCULATE ( [NM Trading Stores], 'Financials'[Scenario] = "Actual", DATESYTD ( 'DimDate'[Date] ) ) - CALCULATE ( [NM Trading Stores], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ), CALCULATE ( [NM Trading Stores], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ) )
			)
		formatString: 0.0%;(0.0%)
		displayFolder: 07 Odd Rows SWITCH
		lineageTag: b69ca24b-8163-5144-a85e-5a85fe5ce2c3

	/// Single dispatch measure for the Odd Rows P&L. One 13-branch SWITCH replaces
	/// thirteen explicit row measures: same leaf measures, same 182 cells, ~40% less time.
	measure 'NM Row Value' =
			
			VAR __Line = SELECTEDVALUE ( 'P&L Odd Rows'[Line] )
			RETURN
			SWITCH (
			    __Line,
			    "Total Income", [NM Total Income],
			    "Total Cost of Sales", [NM Total Cost of Sales],
			    "Gross Profit", [NM Gross Profit],
			    "Total Operating Expenses", [NM Total Operating Expenses],
			    "Net Profit", [NM Net Profit],
			    "Gross Margin %", [NM Gross Margin %],
			    "Net Margin %", [NM Net Margin %],
			    "COGS % of Income", [NM COGS % of Income],
			    "Opex % of Income", [NM Opex % of Income],
			    "Income per Trading Store", [NM Income per Trading Store],
			    "Net Profit per Trading Store", [NM Net Profit per Trading Store],
			    "Income per Active Product", [NM Income per Active Product],
			    "Trading Stores", [NM Trading Stores]
			)
		displayFolder: 06 Odd Rows P&L
		lineageTag: 7a2cebb8-1fa2-5468-9098-dfe506691f5c

		formatStringDefinition = VAR __Line = SELECTEDVALUE ( 'P&L Odd Rows'[Line] ) RETURN SWITCH ( TRUE ( ), __Line IN { "Gross Margin %", "Net Margin %", "COGS % of Income", "Opex % of Income" }, "0.0%;(0.0%)", __Line IN { "Trading Stores" }, "#,##0;(#,##0)", Fmt.Money ( [NM Row Value] ) )

	/// Values-well measure for the two-calculation-group page. Same number as [NM Amount];
	/// the point is the dynamic format string, which reads the ROW calculation group.
	measure 'NM CG Value' =
			
			// numerically identical to [NM Amount]; exists to carry the row-aware format string
			[NM Amount]
		displayFolder: 06 Odd Rows P&L
		lineageTag: 64fcdecb-16d1-5b4b-8fe9-5f798a122b5d

		formatStringDefinition = VAR __Row = SELECTEDVALUE ( 'P&L Row'[P&L Row] ) RETURN SWITCH ( TRUE ( ), __Row IN { "Gross Margin %", "Net Margin %", "COGS % of Income", "Opex % of Income" }, "0.0%;(0.0%)", __Row IN { "Trading Stores" }, "#,##0;(#,##0)", "$#,##0;($#,##0)" )

	/// Distinct trading stores, ignoring any statement-line filter. The Deneb dataset groups
	/// by 'P&L Lines'[Line], and this count must NOT inherit that grouping.
	measure 'NM Stores All Lines' =
			
			CALCULATE ( [NM Trading Stores], REMOVEFILTERS ( 'P&L Lines' ) )
		formatString: #,##0;(#,##0)
		displayFolder: 06 Odd Rows P&L
		lineageTag: 9e7852b2-db40-5428-8c4a-0a0bb67cf564

	/// Distinct active products, ignoring any statement-line filter. ProductKey 0 is the
	/// sentinel for the 19 non-product accounts, not a product.
	measure 'NM Products All Lines' =
			
			CALCULATE (
			    DISTINCTCOUNT ( 'Financials'[ProductKey] ),
			    'Financials'[ProductKey] <> 0,
			    REMOVEFILTERS ( 'P&L Lines' )
			)
		formatString: #,##0;(#,##0)
		displayFolder: 06 Odd Rows P&L
		lineageTag: 04bf2f58-24e8-59c9-89af-d5a9cacccb0c

	/// Fully transparent fill for conditional-formatting slots whose static color
	/// picker has no alpha (slicer header backgrounds, etc). 8-digit hex, alpha 00.
	measure 'UI Transparent' =
			
			"#FFFFFF00"
		displayFolder: 08 UI
		lineageTag: a73c75ff-b3a8-5be4-a6f5-7aed02300bb3

	/// Total Income, actual. Scenario-specific, period-agnostic: the calculation group owns the period.
	measure 'MP Income Act' =
			
			CALCULATE ( [NM Total Income], 'Financials'[Scenario] = "Actual" )
		displayFolder: 09 Monthly P&L
		lineageTag: c63c09e9-1fcf-548e-84de-b1510c57ea8a

		formatStringDefinition = Fmt.Money ( [MP Income Act] )

	/// Total Income, same period last year.
	measure 'MP Income LY' =
			
			CALCULATE ( [MP Income Act], DATEADD ( 'DimDate'[Date], -1, YEAR ) )
		displayFolder: 09 Monthly P&L
		lineageTag: af38bb51-14b9-5d5e-a5c9-84a6c43f9bca

		formatStringDefinition = Fmt.Money ( [MP Income LY] )

	/// Total Cost of Sales, actual. Scenario-specific, period-agnostic: the calculation group owns the period.
	measure 'MP COGS Act' =
			
			CALCULATE ( [NM Total Cost of Sales], 'Financials'[Scenario] = "Actual" )
		displayFolder: 09 Monthly P&L
		lineageTag: c1545ec4-5512-5af5-8495-b2b121f00a83

		formatStringDefinition = Fmt.Money ( [MP COGS Act] )

	/// Total Cost of Sales, same period last year.
	measure 'MP COGS LY' =
			
			CALCULATE ( [MP COGS Act], DATEADD ( 'DimDate'[Date], -1, YEAR ) )
		displayFolder: 09 Monthly P&L
		lineageTag: 4eb7afdb-d1cf-52d6-aeb8-087ac09c10c0

		formatStringDefinition = Fmt.Money ( [MP COGS LY] )

	/// Gross Profit, actual. Scenario-specific, period-agnostic: the calculation group owns the period.
	measure 'MP GP Act' =
			
			CALCULATE ( [NM Gross Profit], 'Financials'[Scenario] = "Actual" )
		displayFolder: 09 Monthly P&L
		lineageTag: 7c06ca37-d9eb-53d2-9c68-36d80a47e36e

		formatStringDefinition = Fmt.Money ( [MP GP Act] )

	/// Gross Profit, same period last year.
	measure 'MP GP LY' =
			
			CALCULATE ( [MP GP Act], DATEADD ( 'DimDate'[Date], -1, YEAR ) )
		displayFolder: 09 Monthly P&L
		lineageTag: 2fac2286-eae8-5856-bfc4-12cd61c8897f

		formatStringDefinition = Fmt.Money ( [MP GP LY] )

	/// Total Operating Expenses, actual. Scenario-specific, period-agnostic: the calculation group owns the period.
	measure 'MP Opex Act' =
			
			CALCULATE ( [NM Total Operating Expenses], 'Financials'[Scenario] = "Actual" )
		displayFolder: 09 Monthly P&L
		lineageTag: c1b03d01-c489-519a-b6d6-e568abfc6e9b

		formatStringDefinition = Fmt.Money ( [MP Opex Act] )

	/// Total Operating Expenses, same period last year.
	measure 'MP Opex LY' =
			
			CALCULATE ( [MP Opex Act], DATEADD ( 'DimDate'[Date], -1, YEAR ) )
		displayFolder: 09 Monthly P&L
		lineageTag: d377dcf2-2fcb-5395-b2a6-8338ccbfdbb9

		formatStringDefinition = Fmt.Money ( [MP Opex LY] )

	/// Net Profit, actual. Scenario-specific, period-agnostic: the calculation group owns the period.
	measure 'MP NP Act' =
			
			CALCULATE ( [NM Net Profit], 'Financials'[Scenario] = "Actual" )
		displayFolder: 09 Monthly P&L
		lineageTag: 91255b6a-7c0d-5497-b3b5-001daae32fdf

		formatStringDefinition = Fmt.Money ( [MP NP Act] )

	/// Net Profit, same period last year.
	measure 'MP NP LY' =
			
			CALCULATE ( [MP NP Act], DATEADD ( 'DimDate'[Date], -1, YEAR ) )
		displayFolder: 09 Monthly P&L
		lineageTag: 0e625826-80b3-5713-8f5b-b3c9a4db6a03

		formatStringDefinition = Fmt.Money ( [MP NP LY] )

	/// Income growth on last year. Blank Act over a real LY is -100%, matching DAX's blank-as-zero subtraction.
	measure 'MP Income Var %' =
			
			DIVIDE ( [MP Income Act] - [MP Income LY], [MP Income LY] )
		displayFolder: 09 Monthly P&L
		lineageTag: fba707ac-46c2-51cb-82c9-c414288d07d5

		formatStringDefinition = IF ( ABS ( [MP Income Var %] ) >= 1, "0%;(0%)", "0.0%;(0.0%)" )

	/// Cost of sales movement on last year. Both sides are negative, so the sign reads as cost growth.
	measure 'MP COGS Var %' =
			
			DIVIDE ( [MP COGS Act] - [MP COGS LY], [MP COGS LY] )
		displayFolder: 09 Monthly P&L
		lineageTag: 16e5da03-26b8-50cb-83ef-84b86165bc0b

		formatStringDefinition = IF ( ABS ( [MP COGS Var %] ) >= 1, "0%;(0%)", "0.0%;(0.0%)" )

	/// Gross profit growth on last year.
	measure 'MP GP Var %' =
			
			DIVIDE ( [MP GP Act] - [MP GP LY], [MP GP LY] )
		displayFolder: 09 Monthly P&L
		lineageTag: 6b02faac-38a6-5ddc-8c8a-a4ae9f1cc018

		formatStringDefinition = IF ( ABS ( [MP GP Var %] ) >= 1, "0%;(0%)", "0.0%;(0.0%)" )

	/// Gross margin, actual.
	measure 'MP GM % Act' =
			
			DIVIDE ( [MP GP Act], [MP Income Act] )
		displayFolder: 09 Monthly P&L
		lineageTag: 19d2d105-1e3c-59e0-bf6b-53fe7bdb977a

		formatStringDefinition = IF ( ABS ( [MP GM % Act] ) >= 1, "0%;(0%)", "0.0%;(0.0%)" )

	/// Gross margin, last year.
	measure 'MP GM % LY' =
			
			DIVIDE ( [MP GP LY], [MP Income LY] )
		displayFolder: 09 Monthly P&L
		lineageTag: e3e98596-0330-5afb-a963-d1b4749ce94d

		formatStringDefinition = IF ( ABS ( [MP GM % LY] ) >= 1, "0%;(0%)", "0.0%;(0.0%)" )

	/// Gross margin movement in points. A difference, not a ratio -- blank only if both sides are blank.
	measure 'MP GM % Var bps' =
			
			[MP GM % Act] - [MP GM % LY]
		displayFolder: 09 Monthly P&L
		lineageTag: faf30470-a592-5177-a2e0-9eb991dafaad

		formatStringDefinition = IF ( ABS ( [MP GM % Var bps] ) >= 1, "0%;(0%)", "0.0%;(0.0%)" )

	/// Operating expense movement on last year.
	measure 'MP Opex Var %' =
			
			DIVIDE ( [MP Opex Act] - [MP Opex LY], [MP Opex LY] )
		displayFolder: 09 Monthly P&L
		lineageTag: adc6ce82-2935-5036-9415-cdd4a5d8e0cc

		formatStringDefinition = IF ( ABS ( [MP Opex Var %] ) >= 1, "0%;(0%)", "0.0%;(0.0%)" )

	/// Operating expenses as a positive share of income. -1 * BLANK() is BLANK, so the blank survives the sign flip.
	measure 'MP Opex % Act' =
			
			DIVIDE ( -1 * [MP Opex Act], [MP Income Act] )
		displayFolder: 09 Monthly P&L
		lineageTag: d80ce830-b84b-56cd-9b25-8f3525caca2d

		formatStringDefinition = IF ( ABS ( [MP Opex % Act] ) >= 1, "0%;(0%)", "0.0%;(0.0%)" )

	/// Operating expense ratio, last year.
	measure 'MP Opex % LY' =
			
			DIVIDE ( -1 * [MP Opex LY], [MP Income LY] )
		displayFolder: 09 Monthly P&L
		lineageTag: 14655108-f5d4-5548-99ff-a5da34b493a9

		formatStringDefinition = IF ( ABS ( [MP Opex % LY] ) >= 1, "0%;(0%)", "0.0%;(0.0%)" )

	/// Operating expense ratio movement in points.
	measure 'MP Opex % Var bps' =
			
			[MP Opex % Act] - [MP Opex % LY]
		displayFolder: 09 Monthly P&L
		lineageTag: 66dc4386-1574-5f6b-9a81-582c0b8a4956

		formatStringDefinition = IF ( ABS ( [MP Opex % Var bps] ) >= 1, "0%;(0%)", "0.0%;(0.0%)" )

	/// Net profit growth on last year.
	measure 'MP NP Var %' =
			
			DIVIDE ( [MP NP Act] - [MP NP LY], [MP NP LY] )
		displayFolder: 09 Monthly P&L
		lineageTag: 5659feca-020c-5ebd-9fd4-8a75840071b7

		formatStringDefinition = IF ( ABS ( [MP NP Var %] ) >= 1, "0%;(0%)", "0.0%;(0.0%)" )

	/// Section band: renders as the 'Income' caption row and returns nothing. Still a measure the dispatch plan has to be able to produce, in all 15 columns.
	measure 'MP Sec Income' =
			
			BLANK ( )
		displayFolder: 09 Monthly P&L
		lineageTag: ace9db21-435a-5def-87d7-79e00e60823c

	/// Section band: renders as the 'Cost of Sales' caption row and returns nothing. Still a measure the dispatch plan has to be able to produce, in all 15 columns.
	measure 'MP Sec Cost of Sales' =
			
			BLANK ( )
		displayFolder: 09 Monthly P&L
		lineageTag: 407bca2c-42ed-5c08-a3b9-9c568cda795e

	/// Section band: renders as the 'Gross Profit' caption row and returns nothing. Still a measure the dispatch plan has to be able to produce, in all 15 columns.
	measure 'MP Sec Gross Profit' =
			
			BLANK ( )
		displayFolder: 09 Monthly P&L
		lineageTag: adeeb546-f272-5ede-9996-111bb5a3545b

	/// Section band: renders as the 'Gross Margin' caption row and returns nothing. Still a measure the dispatch plan has to be able to produce, in all 15 columns.
	measure 'MP Sec Gross Margin' =
			
			BLANK ( )
		displayFolder: 09 Monthly P&L
		lineageTag: a2554995-84f3-5fc1-84a0-7ded23f124be

	/// Section band: renders as the 'Operating Expenses' caption row and returns nothing. Still a measure the dispatch plan has to be able to produce, in all 15 columns.
	measure 'MP Sec Operating Expenses' =
			
			BLANK ( )
		displayFolder: 09 Monthly P&L
		lineageTag: c502728c-27a2-5107-a238-4d09f8b65422

	/// Section band: renders as the 'Cost Ratio' caption row and returns nothing. Still a measure the dispatch plan has to be able to produce, in all 15 columns.
	measure 'MP Sec Cost Ratio' =
			
			BLANK ( )
		displayFolder: 09 Monthly P&L
		lineageTag: d72f9ee7-1d84-518b-ae92-d9680e793fe5

	/// Section band: renders as the 'Net Profit' caption row and returns nothing. Still a measure the dispatch plan has to be able to produce, in all 15 columns.
	measure 'MP Sec Net Profit' =
			
