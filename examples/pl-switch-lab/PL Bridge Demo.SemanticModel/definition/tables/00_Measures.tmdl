	measure 'Slow vs LY % Value' =
			
			VAR __Line = SELECTEDVALUE('P&L Rows'[Line])
			RETURN
			Switch(True(),
			__Line = "    Retail Sales", format(([Actual Retail Sales] - [Actual Retail Sales LY]) / [Actual Retail Sales LY], "0.0%"),
			__Line = "    Wholesale Sales", format(([Actual Wholesale Sales] - [Actual Wholesale Sales LY]) / [Actual Wholesale Sales LY], "0.0%"),
			__Line = "    Online Sales", format(([Actual Online Sales] - [Actual Online Sales LY]) / [Actual Online Sales LY], "0.0%"),
			__Line = "    Delivery & Freight Income", format(([Actual Delivery & Freight Income] - [Actual Delivery & Freight Income LY]) / [Actual Delivery & Freight Income LY], "0.0%"),
			__Line = "Total Income", format(([Actual Total Income] - [Actual Total Income LY]) / [Actual Total Income LY], "0.0%"),
			__Line = "    Cost of Goods - Retail", format(([Actual Cost of Goods - Retail] - [Actual Cost of Goods - Retail LY]) / [Actual Cost of Goods - Retail LY], "0.0%"),
			__Line = "    Cost of Goods - Wholesale", format(([Actual Cost of Goods - Wholesale] - [Actual Cost of Goods - Wholesale LY]) / [Actual Cost of Goods - Wholesale LY], "0.0%"),
			__Line = "    Cost of Goods - Online", format(([Actual Cost of Goods - Online] - [Actual Cost of Goods - Online LY]) / [Actual Cost of Goods - Online LY], "0.0%"),
			__Line = "    Freight Inwards", format(([Actual Freight Inwards] - [Actual Freight Inwards LY]) / [Actual Freight Inwards LY], "0.0%"),
			__Line = "    Stock Adjustments", format(([Actual Stock Adjustments] - [Actual Stock Adjustments LY]) / [Actual Stock Adjustments LY], "0.0%"),
			__Line = "Total Cost of Sales", format(([Actual Total Cost of Sales] - [Actual Total Cost of Sales LY]) / [Actual Total Cost of Sales LY], "0.0%"),
			__Line = "Gross Profit", format(([Actual Gross Profit] - [Actual Gross Profit LY]) / [Actual Gross Profit LY], "0.0%"),
			__Line = "    Salaries & Wages - Stores", format(([Actual Salaries & Wages - Stores] - [Actual Salaries & Wages - Stores LY]) / [Actual Salaries & Wages - Stores LY], "0.0%"),
			__Line = "    Salaries & Wages - Warehouse", format(([Actual Salaries & Wages - Warehouse] - [Actual Salaries & Wages - Warehouse LY]) / [Actual Salaries & Wages - Warehouse LY], "0.0%"),
			__Line = "    Superannuation", format(([Actual Superannuation] - [Actual Superannuation LY]) / [Actual Superannuation LY], "0.0%"),
			__Line = "    Rent & Outgoings", format(([Actual Rent & Outgoings] - [Actual Rent & Outgoings LY]) / [Actual Rent & Outgoings LY], "0.0%"),
			__Line = "    Utilities", format(([Actual Utilities] - [Actual Utilities LY]) / [Actual Utilities LY], "0.0%"),
			__Line = "    Marketing & Advertising", format(([Actual Marketing & Advertising] - [Actual Marketing & Advertising LY]) / [Actual Marketing & Advertising LY], "0.0%"),
			__Line = "    Insurance", format(([Actual Insurance] - [Actual Insurance LY]) / [Actual Insurance LY], "0.0%"),
			__Line = "    Vehicle & Delivery Costs", format(([Actual Vehicle & Delivery Costs] - [Actual Vehicle & Delivery Costs LY]) / [Actual Vehicle & Delivery Costs LY], "0.0%"),
			__Line = "    Repairs & Maintenance", format(([Actual Repairs & Maintenance] - [Actual Repairs & Maintenance LY]) / [Actual Repairs & Maintenance LY], "0.0%"),
			__Line = "    IT & Software", format(([Actual IT & Software] - [Actual IT & Software LY]) / [Actual IT & Software LY], "0.0%"),
			__Line = "    Merchant & Bank Fees", format(([Actual Merchant & Bank Fees] - [Actual Merchant & Bank Fees LY]) / [Actual Merchant & Bank Fees LY], "0.0%"),
			__Line = "    Depreciation", format(([Actual Depreciation] - [Actual Depreciation LY]) / [Actual Depreciation LY], "0.0%"),
			__Line = "    Other Expenses", format(([Actual Other Expenses] - [Actual Other Expenses LY]) / [Actual Other Expenses LY], "0.0%"),
			__Line = "Total Operating Expenses", format(([Actual Total Operating Expenses] - [Actual Total Operating Expenses LY]) / [Actual Total Operating Expenses LY], "0.0%"),
			__Line = "Net Profit", format(([Actual Net Profit] - [Actual Net Profit LY]) / [Actual Net Profit LY], "0.0%")
