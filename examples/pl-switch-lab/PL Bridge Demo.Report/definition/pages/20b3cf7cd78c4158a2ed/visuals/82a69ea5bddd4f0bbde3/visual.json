  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Why these rows are awkward",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "14pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Eight of the 13 rows are lines no set of accounts can express: four ratios, three per-unit metrics and a distinct count. The 14 columns are scenario/time variants, not a dimension.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "What costs time is neither SWITCH nor the calculation group. It is how many INDEPENDENT expressions the query carries: cost tracks (measure columns x calculation items), about 4 ms each on this model. Thirteen row measures x 14 items = 182 scans. One dispatch measure x 14 items = 14.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Same 182 cells, same leaf measures, same numbers: collapsing thirteen row measures into one SWITCH cuts the query ~40%.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Measured, 75M rows, all tied out at 182/182:",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "13 measures via field parameter   1,269 ms cold / 812 ms warm",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "14 SWITCH measures (page 7)       1,125 ms cold / 724 ms warm",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "2nd calculation group as rows     1,030 ms cold / 641 ms warm",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "1 SWITCH measure (this page)        981 ms cold / 597 ms warm",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Note the ordering: removing SWITCH entirely (a second calculation group on rows) is SLOWER than one shallow SWITCH. Cost is instantiation count, not branch count. Put the rows on a GROUPED column instead and it drops to 26 ms; that needs Deneb.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
