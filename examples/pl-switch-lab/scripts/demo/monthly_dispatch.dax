// Generated by scripts/demo/gen_monthly_queries.py -- edit that, not this.
// Filter context pinned to match the page: Year = 2026, no other slicer selections.
// 15 calculation items x 28 measures = 420 dispatched cell evaluations.

EVALUATE
CALCULATETABLE (
    SUMMARIZECOLUMNS (
        'Period View'[Period View],
        'Period View'[Ordinal],
        "Income", [MP Sec Income],
        "Income Act", [MP Income Act],
        "Income LY", [MP Income LY],
        "Income Var %", [MP Income Var %],
        "Cost of Sales", [MP Sec Cost of Sales],
        "Cost of Sales Act", [MP COGS Act],
        "Cost of Sales LY", [MP COGS LY],
        "Cost of Sales Var %", [MP COGS Var %],
        "Gross Profit", [MP Sec Gross Profit],
        "Gross Profit Act", [MP GP Act],
        "Gross Profit LY", [MP GP LY],
        "Gross Profit Var %", [MP GP Var %],
        "Gross Margin", [MP Sec Gross Margin],
        "Gross Margin % Act", [MP GM % Act],
        "Gross Margin % LY", [MP GM % LY],
        "Gross Margin Var bps", [MP GM % Var bps],
        "Operating Expenses", [MP Sec Operating Expenses],
        "Opex Act", [MP Opex Act],
        "Opex LY", [MP Opex LY],
        "Opex Var %", [MP Opex Var %],
        "Cost Ratio", [MP Sec Cost Ratio],
        "Opex % of Income Act", [MP Opex % Act],
        "Opex % of Income LY", [MP Opex % LY],
        "Opex % Var bps", [MP Opex % Var bps],
        "Net Profit", [MP Sec Net Profit],
        "Net Profit Act", [MP NP Act],
        "Net Profit LY", [MP NP LY],
        "Net Profit Var %", [MP NP Var %]
    ),
    'DimDate'[Year] = 2026
)
ORDER BY 'Period View'[Ordinal]
