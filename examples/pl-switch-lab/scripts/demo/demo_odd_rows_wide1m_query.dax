// demo_odd_rows_wide1m_query.dax -- CONTROL for demo_odd_rows_long_query.dax.
// Same single 13-branch dispatch measure, same calc group, same 182 cells --
// but requested WIDE (13 rows x 14 measure columns) the way a matrix asks for them,
// instead of LONG (182 rows x 1 column) the way Deneb has to.
// C vs this isolates SHAPE from measure count.

DEFINE
    VAR __Yr = TREATAS ( { 2026 }, 'DimDate'[Year] )

    MEASURE '00_Measures'[NM Row Value] =
        VAR __Line = SELECTEDVALUE ( 'P&L Odd Rows'[Line] )
        RETURN
        SWITCH (
            __Line,
            "Total Income",                 [NM Total Income],
            "Total Cost of Sales",          [NM Total Cost of Sales],
            "Gross Profit",                 [NM Gross Profit],
            "Total Operating Expenses",     [NM Total Operating Expenses],
            "Net Profit",                   [NM Net Profit],
            "Gross Margin %",               [NM Gross Margin %],
            "Net Margin %",                 [NM Net Margin %],
            "COGS % of Income",             [NM COGS % of Income],
            "Opex % of Income",             [NM Opex % of Income],
            "Income per Trading Store",     [NM Income per Trading Store],
            "Net Profit per Trading Store", [NM Net Profit per Trading Store],
            "Income per Active Product",    [NM Income per Active Product],
            "Trading Stores",               [NM Trading Stores]
        )


EVALUATE
SUMMARIZECOLUMNS (
    'P&L Odd Rows'[Line],
    'P&L Odd Rows'[Sort],
    __Yr,
    "Actual", CALCULATE ( [NM Row Value], 'P&L View'[P&L View] = "Actual" ),
    "LY", CALCULATE ( [NM Row Value], 'P&L View'[P&L View] = "LY" ),
    "vs LY", CALCULATE ( [NM Row Value], 'P&L View'[P&L View] = "vs LY" ),
    "vs LY %", CALCULATE ( [NM Row Value], 'P&L View'[P&L View] = "vs LY %" ),
    "Budget", CALCULATE ( [NM Row Value], 'P&L View'[P&L View] = "Budget" ),
    "Var to Budget", CALCULATE ( [NM Row Value], 'P&L View'[P&L View] = "Var to Budget" ),
    "Var to Budget %", CALCULATE ( [NM Row Value], 'P&L View'[P&L View] = "Var to Budget %" ),
    "YTD Actual", CALCULATE ( [NM Row Value], 'P&L View'[P&L View] = "YTD Actual" ),
    "YTD LY", CALCULATE ( [NM Row Value], 'P&L View'[P&L View] = "YTD LY" ),
    "YTD vs LY", CALCULATE ( [NM Row Value], 'P&L View'[P&L View] = "YTD vs LY" ),
    "YTD vs LY %", CALCULATE ( [NM Row Value], 'P&L View'[P&L View] = "YTD vs LY %" ),
    "YTD Budget", CALCULATE ( [NM Row Value], 'P&L View'[P&L View] = "YTD Budget" ),
    "YTD Var to Budget", CALCULATE ( [NM Row Value], 'P&L View'[P&L View] = "YTD Var to Budget" ),
    "YTD Var to Budget %", CALCULATE ( [NM Row Value], 'P&L View'[P&L View] = "YTD Var to Budget %" )
)
ORDER BY 'P&L Odd Rows'[Sort]
