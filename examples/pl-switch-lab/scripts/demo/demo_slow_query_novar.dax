// demo_slow_query_novar.dax -- CONTROL for the SELECTEDVALUE-hoisting A/B.
// Identical to demo_slow_query.dax except every branch re-declares SELECTEDVALUE
// instead of reading a VAR hoisted to the top. Query-scoped, so the shipped model
// keeps the hoisted (VAR) form. Run both back to back in one session to compare.

DEFINE
    VAR __TP = TREATAS ( { "Selected Period" }, 'Time Period'[Time Period] )
    VAR __Yr = TREATAS ( { 2026 }, 'DimDate'[Year] )

    MEASURE '00_Measures'[NoVar Slow Actual Value] =
    Switch(True(),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Retail Sales", [Actual Retail Sales],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Wholesale Sales", [Actual Wholesale Sales],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Online Sales", [Actual Online Sales],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Delivery & Freight Income", [Actual Delivery & Freight Income],
    SELECTEDVALUE('P&L Rows'[Line]) = "Total Income", [Actual Total Income],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Cost of Goods - Retail", [Actual Cost of Goods - Retail],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Cost of Goods - Wholesale", [Actual Cost of Goods - Wholesale],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Cost of Goods - Online", [Actual Cost of Goods - Online],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Freight Inwards", [Actual Freight Inwards],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Stock Adjustments", [Actual Stock Adjustments],
    SELECTEDVALUE('P&L Rows'[Line]) = "Total Cost of Sales", [Actual Total Cost of Sales],
    SELECTEDVALUE('P&L Rows'[Line]) = "Gross Profit", [Actual Gross Profit],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Salaries & Wages - Stores", [Actual Salaries & Wages - Stores],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Salaries & Wages - Warehouse", [Actual Salaries & Wages - Warehouse],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Superannuation", [Actual Superannuation],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Rent & Outgoings", [Actual Rent & Outgoings],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Utilities", [Actual Utilities],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Marketing & Advertising", [Actual Marketing & Advertising],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Insurance", [Actual Insurance],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Vehicle & Delivery Costs", [Actual Vehicle & Delivery Costs],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Repairs & Maintenance", [Actual Repairs & Maintenance],
    SELECTEDVALUE('P&L Rows'[Line]) = "    IT & Software", [Actual IT & Software],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Merchant & Bank Fees", [Actual Merchant & Bank Fees],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Depreciation", [Actual Depreciation],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Other Expenses", [Actual Other Expenses],
    SELECTEDVALUE('P&L Rows'[Line]) = "Total Operating Expenses", [Actual Total Operating Expenses],
    SELECTEDVALUE('P&L Rows'[Line]) = "Net Profit", [Actual Net Profit]
    )

    MEASURE '00_Measures'[NoVar Slow Budget Value] =
    Switch(True(),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Retail Sales", [Budget Retail Sales],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Wholesale Sales", [Budget Wholesale Sales],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Online Sales", [Budget Online Sales],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Delivery & Freight Income", [Budget Delivery & Freight Income],
    SELECTEDVALUE('P&L Rows'[Line]) = "Total Income", [Budget Total Income],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Cost of Goods - Retail", [Budget Cost of Goods - Retail],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Cost of Goods - Wholesale", [Budget Cost of Goods - Wholesale],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Cost of Goods - Online", [Budget Cost of Goods - Online],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Freight Inwards", [Budget Freight Inwards],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Stock Adjustments", [Budget Stock Adjustments],
    SELECTEDVALUE('P&L Rows'[Line]) = "Total Cost of Sales", [Budget Total Cost of Sales],
    SELECTEDVALUE('P&L Rows'[Line]) = "Gross Profit", [Budget Gross Profit],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Salaries & Wages - Stores", [Budget Salaries & Wages - Stores],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Salaries & Wages - Warehouse", [Budget Salaries & Wages - Warehouse],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Superannuation", [Budget Superannuation],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Rent & Outgoings", [Budget Rent & Outgoings],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Utilities", [Budget Utilities],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Marketing & Advertising", [Budget Marketing & Advertising],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Insurance", [Budget Insurance],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Vehicle & Delivery Costs", [Budget Vehicle & Delivery Costs],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Repairs & Maintenance", [Budget Repairs & Maintenance],
    SELECTEDVALUE('P&L Rows'[Line]) = "    IT & Software", [Budget IT & Software],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Merchant & Bank Fees", [Budget Merchant & Bank Fees],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Depreciation", [Budget Depreciation],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Other Expenses", [Budget Other Expenses],
    SELECTEDVALUE('P&L Rows'[Line]) = "Total Operating Expenses", [Budget Total Operating Expenses],
    SELECTEDVALUE('P&L Rows'[Line]) = "Net Profit", [Budget Net Profit]
    )

    MEASURE '00_Measures'[NoVar Slow Var Value] =
    Switch(True(),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Retail Sales", [Actual Retail Sales] - [Budget Retail Sales],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Wholesale Sales", [Actual Wholesale Sales] - [Budget Wholesale Sales],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Online Sales", [Actual Online Sales] - [Budget Online Sales],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Delivery & Freight Income", [Actual Delivery & Freight Income] - [Budget Delivery & Freight Income],
    SELECTEDVALUE('P&L Rows'[Line]) = "Total Income", [Actual Total Income] - [Budget Total Income],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Cost of Goods - Retail", [Actual Cost of Goods - Retail] - [Budget Cost of Goods - Retail],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Cost of Goods - Wholesale", [Actual Cost of Goods - Wholesale] - [Budget Cost of Goods - Wholesale],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Cost of Goods - Online", [Actual Cost of Goods - Online] - [Budget Cost of Goods - Online],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Freight Inwards", [Actual Freight Inwards] - [Budget Freight Inwards],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Stock Adjustments", [Actual Stock Adjustments] - [Budget Stock Adjustments],
    SELECTEDVALUE('P&L Rows'[Line]) = "Total Cost of Sales", [Actual Total Cost of Sales] - [Budget Total Cost of Sales],
    SELECTEDVALUE('P&L Rows'[Line]) = "Gross Profit", [Actual Gross Profit] - [Budget Gross Profit],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Salaries & Wages - Stores", [Actual Salaries & Wages - Stores] - [Budget Salaries & Wages - Stores],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Salaries & Wages - Warehouse", [Actual Salaries & Wages - Warehouse] - [Budget Salaries & Wages - Warehouse],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Superannuation", [Actual Superannuation] - [Budget Superannuation],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Rent & Outgoings", [Actual Rent & Outgoings] - [Budget Rent & Outgoings],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Utilities", [Actual Utilities] - [Budget Utilities],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Marketing & Advertising", [Actual Marketing & Advertising] - [Budget Marketing & Advertising],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Insurance", [Actual Insurance] - [Budget Insurance],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Vehicle & Delivery Costs", [Actual Vehicle & Delivery Costs] - [Budget Vehicle & Delivery Costs],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Repairs & Maintenance", [Actual Repairs & Maintenance] - [Budget Repairs & Maintenance],
    SELECTEDVALUE('P&L Rows'[Line]) = "    IT & Software", [Actual IT & Software] - [Budget IT & Software],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Merchant & Bank Fees", [Actual Merchant & Bank Fees] - [Budget Merchant & Bank Fees],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Depreciation", [Actual Depreciation] - [Budget Depreciation],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Other Expenses", [Actual Other Expenses] - [Budget Other Expenses],
    SELECTEDVALUE('P&L Rows'[Line]) = "Total Operating Expenses", [Actual Total Operating Expenses] - [Budget Total Operating Expenses],
    SELECTEDVALUE('P&L Rows'[Line]) = "Net Profit", [Actual Net Profit] - [Budget Net Profit]
    )

    MEASURE '00_Measures'[NoVar Slow Var % Value] =
    Switch(True(),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Retail Sales", format(([Actual Retail Sales] - [Budget Retail Sales]) / [Budget Retail Sales], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Wholesale Sales", format(([Actual Wholesale Sales] - [Budget Wholesale Sales]) / [Budget Wholesale Sales], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Online Sales", format(([Actual Online Sales] - [Budget Online Sales]) / [Budget Online Sales], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Delivery & Freight Income", format(([Actual Delivery & Freight Income] - [Budget Delivery & Freight Income]) / [Budget Delivery & Freight Income], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "Total Income", format(([Actual Total Income] - [Budget Total Income]) / [Budget Total Income], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Cost of Goods - Retail", format(([Actual Cost of Goods - Retail] - [Budget Cost of Goods - Retail]) / [Budget Cost of Goods - Retail], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Cost of Goods - Wholesale", format(([Actual Cost of Goods - Wholesale] - [Budget Cost of Goods - Wholesale]) / [Budget Cost of Goods - Wholesale], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Cost of Goods - Online", format(([Actual Cost of Goods - Online] - [Budget Cost of Goods - Online]) / [Budget Cost of Goods - Online], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Freight Inwards", format(([Actual Freight Inwards] - [Budget Freight Inwards]) / [Budget Freight Inwards], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Stock Adjustments", format(([Actual Stock Adjustments] - [Budget Stock Adjustments]) / [Budget Stock Adjustments], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "Total Cost of Sales", format(([Actual Total Cost of Sales] - [Budget Total Cost of Sales]) / [Budget Total Cost of Sales], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "Gross Profit", format(([Actual Gross Profit] - [Budget Gross Profit]) / [Budget Gross Profit], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Salaries & Wages - Stores", format(([Actual Salaries & Wages - Stores] - [Budget Salaries & Wages - Stores]) / [Budget Salaries & Wages - Stores], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Salaries & Wages - Warehouse", format(([Actual Salaries & Wages - Warehouse] - [Budget Salaries & Wages - Warehouse]) / [Budget Salaries & Wages - Warehouse], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Superannuation", format(([Actual Superannuation] - [Budget Superannuation]) / [Budget Superannuation], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Rent & Outgoings", format(([Actual Rent & Outgoings] - [Budget Rent & Outgoings]) / [Budget Rent & Outgoings], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Utilities", format(([Actual Utilities] - [Budget Utilities]) / [Budget Utilities], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Marketing & Advertising", format(([Actual Marketing & Advertising] - [Budget Marketing & Advertising]) / [Budget Marketing & Advertising], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Insurance", format(([Actual Insurance] - [Budget Insurance]) / [Budget Insurance], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Vehicle & Delivery Costs", format(([Actual Vehicle & Delivery Costs] - [Budget Vehicle & Delivery Costs]) / [Budget Vehicle & Delivery Costs], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Repairs & Maintenance", format(([Actual Repairs & Maintenance] - [Budget Repairs & Maintenance]) / [Budget Repairs & Maintenance], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    IT & Software", format(([Actual IT & Software] - [Budget IT & Software]) / [Budget IT & Software], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Merchant & Bank Fees", format(([Actual Merchant & Bank Fees] - [Budget Merchant & Bank Fees]) / [Budget Merchant & Bank Fees], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Depreciation", format(([Actual Depreciation] - [Budget Depreciation]) / [Budget Depreciation], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Other Expenses", format(([Actual Other Expenses] - [Budget Other Expenses]) / [Budget Other Expenses], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "Total Operating Expenses", format(([Actual Total Operating Expenses] - [Budget Total Operating Expenses]) / [Budget Total Operating Expenses], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "Net Profit", format(([Actual Net Profit] - [Budget Net Profit]) / [Budget Net Profit], "0.0%")
    )

    MEASURE '00_Measures'[NoVar Slow LY Value] =
    Switch(True(),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Retail Sales", [Actual Retail Sales LY],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Wholesale Sales", [Actual Wholesale Sales LY],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Online Sales", [Actual Online Sales LY],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Delivery & Freight Income", [Actual Delivery & Freight Income LY],
    SELECTEDVALUE('P&L Rows'[Line]) = "Total Income", [Actual Total Income LY],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Cost of Goods - Retail", [Actual Cost of Goods - Retail LY],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Cost of Goods - Wholesale", [Actual Cost of Goods - Wholesale LY],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Cost of Goods - Online", [Actual Cost of Goods - Online LY],
