    SELECTEDVALUE('P&L Rows'[Line]) = "    Freight Inwards", format(([Actual Freight Inwards] - [Actual Freight Inwards LY]) / [Actual Freight Inwards LY], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Stock Adjustments", format(([Actual Stock Adjustments] - [Actual Stock Adjustments LY]) / [Actual Stock Adjustments LY], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "Total Cost of Sales", format(([Actual Total Cost of Sales] - [Actual Total Cost of Sales LY]) / [Actual Total Cost of Sales LY], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "Gross Profit", format(([Actual Gross Profit] - [Actual Gross Profit LY]) / [Actual Gross Profit LY], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Salaries & Wages - Stores", format(([Actual Salaries & Wages - Stores] - [Actual Salaries & Wages - Stores LY]) / [Actual Salaries & Wages - Stores LY], "0.0%"),
