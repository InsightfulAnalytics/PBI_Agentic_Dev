    SELECTEDVALUE('P&L Rows'[Line]) = "    Cost of Goods - Retail", format(([Actual Cost of Goods - Retail] - [Actual Cost of Goods - Retail LY]) / [Actual Cost of Goods - Retail LY], "0.0%"),
