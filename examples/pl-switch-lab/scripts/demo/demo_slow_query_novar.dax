    SELECTEDVALUE('P&L Rows'[Line]) = "    Rent & Outgoings", [Actual Rent & Outgoings LY],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Utilities", [Actual Utilities LY],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Marketing & Advertising", [Actual Marketing & Advertising LY],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Insurance", [Actual Insurance LY],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Vehicle & Delivery Costs", [Actual Vehicle & Delivery Costs LY],
