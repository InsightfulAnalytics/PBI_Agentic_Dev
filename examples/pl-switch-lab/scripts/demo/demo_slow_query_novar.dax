    SELECTEDVALUE('P&L Rows'[Line]) = "    Wholesale Sales", format(([Actual Wholesale Sales YTD] - [Actual Wholesale Sales YTD LY]) / [Actual Wholesale Sales YTD LY], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Online Sales", format(([Actual Online Sales YTD] - [Actual Online Sales YTD LY]) / [Actual Online Sales YTD LY], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Delivery & Freight Income", format(([Actual Delivery & Freight Income YTD] - [Actual Delivery & Freight Income YTD LY]) / [Actual Delivery & Freight Income YTD LY], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "Total Income", format(([Actual Total Income YTD] - [Actual Total Income YTD LY]) / [Actual Total Income YTD LY], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Cost of Goods - Retail", format(([Actual Cost of Goods - Retail YTD] - [Actual Cost of Goods - Retail YTD LY]) / [Actual Cost of Goods - Retail YTD LY], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Cost of Goods - Wholesale", format(([Actual Cost of Goods - Wholesale YTD] - [Actual Cost of Goods - Wholesale YTD LY]) / [Actual Cost of Goods - Wholesale YTD LY], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Cost of Goods - Online", format(([Actual Cost of Goods - Online YTD] - [Actual Cost of Goods - Online YTD LY]) / [Actual Cost of Goods - Online YTD LY], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Freight Inwards", format(([Actual Freight Inwards YTD] - [Actual Freight Inwards YTD LY]) / [Actual Freight Inwards YTD LY], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Stock Adjustments", format(([Actual Stock Adjustments YTD] - [Actual Stock Adjustments YTD LY]) / [Actual Stock Adjustments YTD LY], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "Total Cost of Sales", format(([Actual Total Cost of Sales YTD] - [Actual Total Cost of Sales YTD LY]) / [Actual Total Cost of Sales YTD LY], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "Gross Profit", format(([Actual Gross Profit YTD] - [Actual Gross Profit YTD LY]) / [Actual Gross Profit YTD LY], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Salaries & Wages - Stores", format(([Actual Salaries & Wages - Stores YTD] - [Actual Salaries & Wages - Stores YTD LY]) / [Actual Salaries & Wages - Stores YTD LY], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Salaries & Wages - Warehouse", format(([Actual Salaries & Wages - Warehouse YTD] - [Actual Salaries & Wages - Warehouse YTD LY]) / [Actual Salaries & Wages - Warehouse YTD LY], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Superannuation", format(([Actual Superannuation YTD] - [Actual Superannuation YTD LY]) / [Actual Superannuation YTD LY], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Rent & Outgoings", format(([Actual Rent & Outgoings YTD] - [Actual Rent & Outgoings YTD LY]) / [Actual Rent & Outgoings YTD LY], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Utilities", format(([Actual Utilities YTD] - [Actual Utilities YTD LY]) / [Actual Utilities YTD LY], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Marketing & Advertising", format(([Actual Marketing & Advertising YTD] - [Actual Marketing & Advertising YTD LY]) / [Actual Marketing & Advertising YTD LY], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Insurance", format(([Actual Insurance YTD] - [Actual Insurance YTD LY]) / [Actual Insurance YTD LY], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Vehicle & Delivery Costs", format(([Actual Vehicle & Delivery Costs YTD] - [Actual Vehicle & Delivery Costs YTD LY]) / [Actual Vehicle & Delivery Costs YTD LY], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Repairs & Maintenance", format(([Actual Repairs & Maintenance YTD] - [Actual Repairs & Maintenance YTD LY]) / [Actual Repairs & Maintenance YTD LY], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    IT & Software", format(([Actual IT & Software YTD] - [Actual IT & Software YTD LY]) / [Actual IT & Software YTD LY], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Merchant & Bank Fees", format(([Actual Merchant & Bank Fees YTD] - [Actual Merchant & Bank Fees YTD LY]) / [Actual Merchant & Bank Fees YTD LY], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Depreciation", format(([Actual Depreciation YTD] - [Actual Depreciation YTD LY]) / [Actual Depreciation YTD LY], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Other Expenses", format(([Actual Other Expenses YTD] - [Actual Other Expenses YTD LY]) / [Actual Other Expenses YTD LY], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "Total Operating Expenses", format(([Actual Total Operating Expenses YTD] - [Actual Total Operating Expenses YTD LY]) / [Actual Total Operating Expenses YTD LY], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "Net Profit", format(([Actual Net Profit YTD] - [Actual Net Profit YTD LY]) / [Actual Net Profit YTD LY], "0.0%")
    )

EVALUATE
SUMMARIZECOLUMNS (
    'P&L Rows'[Line],
    'P&L Rows'[Sort],
    __TP, __Yr,
    "Slow Actual Value", [NoVar Slow Actual Value],
    "Slow Budget Value", [NoVar Slow Budget Value],
    "Slow Var Value", [NoVar Slow Var Value],
    "Slow Var % Value", [NoVar Slow Var % Value],
    "Slow LY Value", [NoVar Slow LY Value],
    "Slow vs LY Value", [NoVar Slow vs LY Value],
    "Slow vs LY % Value", [NoVar Slow vs LY % Value],
    "Slow Actual YTD Value", [NoVar Slow Actual YTD Value],
    "Slow Budget YTD Value", [NoVar Slow Budget YTD Value],
    "Slow Var YTD Value", [NoVar Slow Var YTD Value],
    "Slow Var % YTD Value", [NoVar Slow Var % YTD Value],
    "Slow LY YTD Value", [NoVar Slow LY YTD Value],
    "Slow vs LY YTD Value", [NoVar Slow vs LY YTD Value],
    "Slow vs LY % YTD Value", [NoVar Slow vs LY % YTD Value]
)
ORDER BY 'P&L Rows'[Sort]
