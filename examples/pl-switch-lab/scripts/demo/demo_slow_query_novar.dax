    MEASURE '00_Measures'[NoVar Slow vs LY % Value] =
    Switch(True(),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Retail Sales", format(([Actual Retail Sales] - [Actual Retail Sales LY]) / [Actual Retail Sales LY], "0.0%"),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Wholesale Sales", format(([Actual Wholesale Sales] - [Actual Wholesale Sales LY]) / [Actual Wholesale Sales LY], "0.0%"),
