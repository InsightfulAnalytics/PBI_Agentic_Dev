    SELECTEDVALUE('P&L Rows'[Line]) = "Gross Profit", [Actual Gross Profit] - [Actual Gross Profit LY],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Salaries & Wages - Stores", [Actual Salaries & Wages - Stores] - [Actual Salaries & Wages - Stores LY],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Salaries & Wages - Warehouse", [Actual Salaries & Wages - Warehouse] - [Actual Salaries & Wages - Warehouse LY],
