    Switch(True(),
    SELECTEDVALUE('P&L Rows'[Line]) = "    Retail Sales", [Actual Retail Sales] - [Actual Retail Sales LY],
    SELECTEDVALUE('P&L Rows'[Line]) = "    Wholesale Sales", [Actual Wholesale Sales] - [Actual Wholesale Sales LY],
