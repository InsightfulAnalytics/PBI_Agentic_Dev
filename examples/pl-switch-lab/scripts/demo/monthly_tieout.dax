// Generated by scripts/demo/gen_monthly_queries.py -- edit that, not this.
// Filter context pinned to match the page: Year = 2026, no other slicer selections.
// Cell-for-cell tie-out: the calculation group vs the same numbers derived from the flat
// monthly dataset, exactly as the Vega spec derives them. Gate: BADDIFF_cells = 0.
//
// This is the query that proves the fast page is not just fast. It is deliberately slow --
// it runs the dispatch side -- so do not use it for timing.

DEFINE
    VAR __CurP =
        CALCULATE (
            MAX ( 'DimDate'[MonthOfYear] ),
            REMOVEFILTERS ( 'DimDate' ),
            'DimDate'[MonthOffset] = 0
        )

    // --- side A: through the calculation group, one row per period item ------------------
    VAR __A =
        CALCULATETABLE (
            SUMMARIZECOLUMNS (
                'Period View'[Period View],
                "inc_act", [MP Income Act],
                "inc_ly", [MP Income LY],
                "inc_var", [MP Income Var %],
                "cog_act", [MP COGS Act],
                "cog_ly", [MP COGS LY],
                "cog_var", [MP COGS Var %],
                "gp_act", [MP GP Act],
                "gp_ly", [MP GP LY],
                "gp_var", [MP GP Var %],
                "gm_act", [MP GM % Act],
                "gm_ly", [MP GM % LY],
                "gm_var", [MP GM % Var bps],
                "opx_act", [MP Opex Act],
                "opx_ly", [MP Opex LY],
                "opx_var", [MP Opex Var %],
                "opr_act", [MP Opex % Act],
                "opr_ly", [MP Opex % LY],
                "opr_var", [MP Opex % Var bps],
                "np_act", [MP NP Act],
                "np_ly", [MP NP LY],
                "np_var", [MP NP Var %]
            ),
            'DimDate'[Year] = 2026
        )

    // --- side B: the flat monthly dataset, aggregated and then derived -------------------
    VAR __Months =
        CALCULATETABLE (
            SUMMARIZECOLUMNS (
                'DimDate'[MonthOfYear],
                "IncAct", [MP Income Act],
                "IncLY", [MP Income LY],
                "CogAct", [MP COGS Act],
                "CogLY", [MP COGS LY],
                "GPAct", [MP GP Act],
                "GPLY", [MP GP LY],
                "OpxAct", [MP Opex Act],
                "OpxLY", [MP Opex LY],
                "NPAct", [MP NP Act],
                "NPLY", [MP NP LY]
            ),
            'DimDate'[Year] = 2026
        )

    VAR __ColBase =
        UNION (
            SELECTCOLUMNS (
                __Months,
                "Col", SWITCH ( [MonthOfYear], 1, "Jan", 2, "Feb", 3, "Mar", 4, "Apr", 5, "May", 6, "Jun", 7, "Jul", 8, "Aug", 9, "Sep", 10, "Oct", 11, "Nov", 12, "Dec" ),
                "IncAct", [IncAct],
                "IncLY", [IncLY],
                "CogAct", [CogAct],
                "CogLY", [CogLY],
                "GPAct", [GPAct],
                "GPLY", [GPLY],
                "OpxAct", [OpxAct],
                "OpxLY", [OpxLY],
                "NPAct", [NPAct],
                "NPLY", [NPLY]
            ),
            SELECTCOLUMNS (
                ROW ( "k", 1 ),
                "Col", "YTD",
                "IncAct", SUMX ( FILTER ( __Months, [MonthOfYear] <= __CurP ), [IncAct] ),
                "IncLY", SUMX ( FILTER ( __Months, [MonthOfYear] <= __CurP ), [IncLY] ),
                "CogAct", SUMX ( FILTER ( __Months, [MonthOfYear] <= __CurP ), [CogAct] ),
                "CogLY", SUMX ( FILTER ( __Months, [MonthOfYear] <= __CurP ), [CogLY] ),
                "GPAct", SUMX ( FILTER ( __Months, [MonthOfYear] <= __CurP ), [GPAct] ),
                "GPLY", SUMX ( FILTER ( __Months, [MonthOfYear] <= __CurP ), [GPLY] ),
                "OpxAct", SUMX ( FILTER ( __Months, [MonthOfYear] <= __CurP ), [OpxAct] ),
                "OpxLY", SUMX ( FILTER ( __Months, [MonthOfYear] <= __CurP ), [OpxLY] ),
                "NPAct", SUMX ( FILTER ( __Months, [MonthOfYear] <= __CurP ), [NPAct] ),
                "NPLY", SUMX ( FILTER ( __Months, [MonthOfYear] <= __CurP ), [NPLY] )
            ),
            SELECTCOLUMNS (
                ROW ( "k", 1 ),
                "Col", "YTG",
                "IncAct", SUMX ( FILTER ( __Months, [MonthOfYear] > __CurP ), [IncAct] ),
                "IncLY", SUMX ( FILTER ( __Months, [MonthOfYear] > __CurP ), [IncLY] ),
                "CogAct", SUMX ( FILTER ( __Months, [MonthOfYear] > __CurP ), [CogAct] ),
                "CogLY", SUMX ( FILTER ( __Months, [MonthOfYear] > __CurP ), [CogLY] ),
                "GPAct", SUMX ( FILTER ( __Months, [MonthOfYear] > __CurP ), [GPAct] ),
                "GPLY", SUMX ( FILTER ( __Months, [MonthOfYear] > __CurP ), [GPLY] ),
                "OpxAct", SUMX ( FILTER ( __Months, [MonthOfYear] > __CurP ), [OpxAct] ),
                "OpxLY", SUMX ( FILTER ( __Months, [MonthOfYear] > __CurP ), [OpxLY] ),
                "NPAct", SUMX ( FILTER ( __Months, [MonthOfYear] > __CurP ), [NPAct] ),
                "NPLY", SUMX ( FILTER ( __Months, [MonthOfYear] > __CurP ), [NPLY] )
            ),
            SELECTCOLUMNS (
                ROW ( "k", 1 ),
                "Col", "Full Year",
                "IncAct", SUMX ( FILTER ( __Months, TRUE ( ) ), [IncAct] ),
                "IncLY", SUMX ( FILTER ( __Months, TRUE ( ) ), [IncLY] ),
                "CogAct", SUMX ( FILTER ( __Months, TRUE ( ) ), [CogAct] ),
                "CogLY", SUMX ( FILTER ( __Months, TRUE ( ) ), [CogLY] ),
                "GPAct", SUMX ( FILTER ( __Months, TRUE ( ) ), [GPAct] ),
                "GPLY", SUMX ( FILTER ( __Months, TRUE ( ) ), [GPLY] ),
                "OpxAct", SUMX ( FILTER ( __Months, TRUE ( ) ), [OpxAct] ),
                "OpxLY", SUMX ( FILTER ( __Months, TRUE ( ) ), [OpxLY] ),
                "NPAct", SUMX ( FILTER ( __Months, TRUE ( ) ), [NPAct] ),
                "NPLY", SUMX ( FILTER ( __Months, TRUE ( ) ), [NPLY] )
            )
        )

    VAR __Derived1 =
        ADDCOLUMNS (
            __ColBase,
                "inc_act", [IncAct],
                "inc_ly", [IncLY],
                "inc_var", DIVIDE ( [IncAct] - [IncLY], [IncLY] ),
                "cog_act", [CogAct],
                "cog_ly", [CogLY],
                "cog_var", DIVIDE ( [CogAct] - [CogLY], [CogLY] ),
                "gp_act", [GPAct],
                "gp_ly", [GPLY],
                "gp_var", DIVIDE ( [GPAct] - [GPLY], [GPLY] ),
                "gm_act", DIVIDE ( [GPAct], [IncAct] ),
                "gm_ly", DIVIDE ( [GPLY], [IncLY] ),
                "opx_act", [OpxAct],
                "opx_ly", [OpxLY],
                "opx_var", DIVIDE ( [OpxAct] - [OpxLY], [OpxLY] ),
                "opr_act", DIVIDE ( -1 * [OpxAct], [IncAct] ),
                "opr_ly", DIVIDE ( -1 * [OpxLY], [IncLY] ),
                "np_act", [NPAct],
                "np_ly", [NPLY],
                "np_var", DIVIDE ( [NPAct] - [NPLY], [NPLY] )
        )

    VAR __B =
        ADDCOLUMNS (
            __Derived1,
                "gm_var", [gm_act] - [gm_ly],
                "opr_var", [opr_act] - [opr_ly]
        )

    // --- diff -----------------------------------------------------------------------------
    VAR __Scored =
        ADDCOLUMNS (
            __A,
            "BadCells",
                VAR __col = 'Period View'[Period View]
                VAR __Row = FILTER ( __B, [Col] = __col )
                    VAR __b_inc_act = MAXX ( __Row, [inc_act] )
                    VAR __b_inc_ly = MAXX ( __Row, [inc_ly] )
                    VAR __b_inc_var = MAXX ( __Row, [inc_var] )
                    VAR __b_cog_act = MAXX ( __Row, [cog_act] )
                    VAR __b_cog_ly = MAXX ( __Row, [cog_ly] )
                    VAR __b_cog_var = MAXX ( __Row, [cog_var] )
                    VAR __b_gp_act = MAXX ( __Row, [gp_act] )
                    VAR __b_gp_ly = MAXX ( __Row, [gp_ly] )
                    VAR __b_gp_var = MAXX ( __Row, [gp_var] )
                    VAR __b_gm_act = MAXX ( __Row, [gm_act] )
                    VAR __b_gm_ly = MAXX ( __Row, [gm_ly] )
                    VAR __b_gm_var = MAXX ( __Row, [gm_var] )
                    VAR __b_opx_act = MAXX ( __Row, [opx_act] )
                    VAR __b_opx_ly = MAXX ( __Row, [opx_ly] )
                    VAR __b_opx_var = MAXX ( __Row, [opx_var] )
                    VAR __b_opr_act = MAXX ( __Row, [opr_act] )
                    VAR __b_opr_ly = MAXX ( __Row, [opr_ly] )
                    VAR __b_opr_var = MAXX ( __Row, [opr_var] )
                    VAR __b_np_act = MAXX ( __Row, [np_act] )
                    VAR __b_np_ly = MAXX ( __Row, [np_ly] )
                    VAR __b_np_var = MAXX ( __Row, [np_var] )
                VAR __Bad =
                    IF ( ISBLANK ( [inc_act] ) && ISBLANK ( __b_inc_act ), 0,
                        IF ( ISBLANK ( [inc_act] ) <> ISBLANK ( __b_inc_act ), 1,
                        IF ( ABS ( [inc_act] - __b_inc_act ) <= 1E-9 * MAX ( 1, ABS ( [inc_act] ) ), 0, 1 ) ) )
                      + IF ( ISBLANK ( [inc_ly] ) && ISBLANK ( __b_inc_ly ), 0,
                        IF ( ISBLANK ( [inc_ly] ) <> ISBLANK ( __b_inc_ly ), 1,
                        IF ( ABS ( [inc_ly] - __b_inc_ly ) <= 1E-9 * MAX ( 1, ABS ( [inc_ly] ) ), 0, 1 ) ) )
                      + IF ( ISBLANK ( [inc_var] ) && ISBLANK ( __b_inc_var ), 0,
                        IF ( ISBLANK ( [inc_var] ) <> ISBLANK ( __b_inc_var ), 1,
                        IF ( ABS ( [inc_var] - __b_inc_var ) <= 1E-9 * MAX ( 1, ABS ( [inc_var] ) ), 0, 1 ) ) )
                      + IF ( ISBLANK ( [cog_act] ) && ISBLANK ( __b_cog_act ), 0,
                        IF ( ISBLANK ( [cog_act] ) <> ISBLANK ( __b_cog_act ), 1,
                        IF ( ABS ( [cog_act] - __b_cog_act ) <= 1E-9 * MAX ( 1, ABS ( [cog_act] ) ), 0, 1 ) ) )
                      + IF ( ISBLANK ( [cog_ly] ) && ISBLANK ( __b_cog_ly ), 0,
                        IF ( ISBLANK ( [cog_ly] ) <> ISBLANK ( __b_cog_ly ), 1,
                        IF ( ABS ( [cog_ly] - __b_cog_ly ) <= 1E-9 * MAX ( 1, ABS ( [cog_ly] ) ), 0, 1 ) ) )
                      + IF ( ISBLANK ( [cog_var] ) && ISBLANK ( __b_cog_var ), 0,
                        IF ( ISBLANK ( [cog_var] ) <> ISBLANK ( __b_cog_var ), 1,
                        IF ( ABS ( [cog_var] - __b_cog_var ) <= 1E-9 * MAX ( 1, ABS ( [cog_var] ) ), 0, 1 ) ) )
                      + IF ( ISBLANK ( [gp_act] ) && ISBLANK ( __b_gp_act ), 0,
                        IF ( ISBLANK ( [gp_act] ) <> ISBLANK ( __b_gp_act ), 1,
                        IF ( ABS ( [gp_act] - __b_gp_act ) <= 1E-9 * MAX ( 1, ABS ( [gp_act] ) ), 0, 1 ) ) )
                      + IF ( ISBLANK ( [gp_ly] ) && ISBLANK ( __b_gp_ly ), 0,
                        IF ( ISBLANK ( [gp_ly] ) <> ISBLANK ( __b_gp_ly ), 1,
                        IF ( ABS ( [gp_ly] - __b_gp_ly ) <= 1E-9 * MAX ( 1, ABS ( [gp_ly] ) ), 0, 1 ) ) )
                      + IF ( ISBLANK ( [gp_var] ) && ISBLANK ( __b_gp_var ), 0,
                        IF ( ISBLANK ( [gp_var] ) <> ISBLANK ( __b_gp_var ), 1,
                        IF ( ABS ( [gp_var] - __b_gp_var ) <= 1E-9 * MAX ( 1, ABS ( [gp_var] ) ), 0, 1 ) ) )
                      + IF ( ISBLANK ( [gm_act] ) && ISBLANK ( __b_gm_act ), 0,
                        IF ( ISBLANK ( [gm_act] ) <> ISBLANK ( __b_gm_act ), 1,
                        IF ( ABS ( [gm_act] - __b_gm_act ) <= 1E-9 * MAX ( 1, ABS ( [gm_act] ) ), 0, 1 ) ) )
                      + IF ( ISBLANK ( [gm_ly] ) && ISBLANK ( __b_gm_ly ), 0,
                        IF ( ISBLANK ( [gm_ly] ) <> ISBLANK ( __b_gm_ly ), 1,
                        IF ( ABS ( [gm_ly] - __b_gm_ly ) <= 1E-9 * MAX ( 1, ABS ( [gm_ly] ) ), 0, 1 ) ) )
                      + IF ( ISBLANK ( [gm_var] ) && ISBLANK ( __b_gm_var ), 0,
                        IF ( ISBLANK ( [gm_var] ) <> ISBLANK ( __b_gm_var ), 1,
                        IF ( ABS ( [gm_var] - __b_gm_var ) <= 1E-9 * MAX ( 1, ABS ( [gm_var] ) ), 0, 1 ) ) )
                      + IF ( ISBLANK ( [opx_act] ) && ISBLANK ( __b_opx_act ), 0,
                        IF ( ISBLANK ( [opx_act] ) <> ISBLANK ( __b_opx_act ), 1,
                        IF ( ABS ( [opx_act] - __b_opx_act ) <= 1E-9 * MAX ( 1, ABS ( [opx_act] ) ), 0, 1 ) ) )
                      + IF ( ISBLANK ( [opx_ly] ) && ISBLANK ( __b_opx_ly ), 0,
                        IF ( ISBLANK ( [opx_ly] ) <> ISBLANK ( __b_opx_ly ), 1,
                        IF ( ABS ( [opx_ly] - __b_opx_ly ) <= 1E-9 * MAX ( 1, ABS ( [opx_ly] ) ), 0, 1 ) ) )
                      + IF ( ISBLANK ( [opx_var] ) && ISBLANK ( __b_opx_var ), 0,
                        IF ( ISBLANK ( [opx_var] ) <> ISBLANK ( __b_opx_var ), 1,
                        IF ( ABS ( [opx_var] - __b_opx_var ) <= 1E-9 * MAX ( 1, ABS ( [opx_var] ) ), 0, 1 ) ) )
                      + IF ( ISBLANK ( [opr_act] ) && ISBLANK ( __b_opr_act ), 0,
                        IF ( ISBLANK ( [opr_act] ) <> ISBLANK ( __b_opr_act ), 1,
                        IF ( ABS ( [opr_act] - __b_opr_act ) <= 1E-9 * MAX ( 1, ABS ( [opr_act] ) ), 0, 1 ) ) )
                      + IF ( ISBLANK ( [opr_ly] ) && ISBLANK ( __b_opr_ly ), 0,
                        IF ( ISBLANK ( [opr_ly] ) <> ISBLANK ( __b_opr_ly ), 1,
                        IF ( ABS ( [opr_ly] - __b_opr_ly ) <= 1E-9 * MAX ( 1, ABS ( [opr_ly] ) ), 0, 1 ) ) )
                      + IF ( ISBLANK ( [opr_var] ) && ISBLANK ( __b_opr_var ), 0,
                        IF ( ISBLANK ( [opr_var] ) <> ISBLANK ( __b_opr_var ), 1,
                        IF ( ABS ( [opr_var] - __b_opr_var ) <= 1E-9 * MAX ( 1, ABS ( [opr_var] ) ), 0, 1 ) ) )
                      + IF ( ISBLANK ( [np_act] ) && ISBLANK ( __b_np_act ), 0,
                        IF ( ISBLANK ( [np_act] ) <> ISBLANK ( __b_np_act ), 1,
                        IF ( ABS ( [np_act] - __b_np_act ) <= 1E-9 * MAX ( 1, ABS ( [np_act] ) ), 0, 1 ) ) )
                      + IF ( ISBLANK ( [np_ly] ) && ISBLANK ( __b_np_ly ), 0,
                        IF ( ISBLANK ( [np_ly] ) <> ISBLANK ( __b_np_ly ), 1,
                        IF ( ABS ( [np_ly] - __b_np_ly ) <= 1E-9 * MAX ( 1, ABS ( [np_ly] ) ), 0, 1 ) ) )
                      + IF ( ISBLANK ( [np_var] ) && ISBLANK ( __b_np_var ), 0,
                        IF ( ISBLANK ( [np_var] ) <> ISBLANK ( __b_np_var ), 1,
                        IF ( ABS ( [np_var] - __b_np_var ) <= 1E-9 * MAX ( 1, ABS ( [np_var] ) ), 0, 1 ) ) )
                RETURN
                    IF ( ISEMPTY ( __Row ), 21, __Bad )
        )

EVALUATE
ROW (
    "Columns_compared", COUNTROWS ( __A ),
    "Cells_compared", COUNTROWS ( __A ) * 21,
    "BADDIFF_cells", COALESCE ( SUMX ( __Scored, [BadCells] ), 0 ),
    "CurrentMonth", __CurP
)
