// demo_fast_query.dax -- the bridge P&L, exactly as the report's
// "P&L - Fast Bridge" table plans it: 27 bridge rows x 14 fast measures.
// The rows come from the physical 'P&L Lines' bridge table; the bidirectional
// Lines -> Accounts relationship does the filtering, zero SWITCH branches.
// Pins match the statement pages' filterConfig: Year 2026, Selected Period.
// Run: scripts\time_query.ps1 -QueryFile "scripts\demo\demo_fast_query.dax"

DEFINE
    VAR __TP = TREATAS ( { "Selected Period" }, 'Time Period'[Time Period] )
    VAR __Yr = TREATAS ( { 2026 }, 'DimDate'[Year] )
EVALUATE
SUMMARIZECOLUMNS (
    'P&L Lines'[Line],
    'P&L Lines'[LineKey],
    __TP, __Yr,
    "Actual",       [P&L Actual],
    "Budget",       [P&L Budget],
    "Var",          [P&L Var],
    "Var %",        [P&L Var %],
    "LY",           [P&L LY],
    "vs LY",        [P&L vs LY],
    "vs LY %",      [P&L vs LY %],
    "YTD Actual",   [P&L Actual YTD],
    "YTD Budget",   [P&L Budget YTD],
    "YTD Var",      [P&L Var YTD],
    "YTD Var %",    [P&L Var % YTD],
    "YTD LY",       [P&L LY YTD],
    "YTD vs LY",    [P&L vs LY YTD],
    "YTD vs LY %",  [P&L vs LY % YTD]
)
ORDER BY 'P&L Lines'[LineKey]
