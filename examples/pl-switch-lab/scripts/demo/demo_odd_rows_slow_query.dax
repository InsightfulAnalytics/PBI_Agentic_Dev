        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 10,
            CALCULATE ( [NM Net Profit per Trading Store], 'Financials'[Scenario] = "Actual", DATESYTD ( 'DimDate'[Date] ) ) - CALCULATE ( [NM Net Profit per Trading Store], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 11,
