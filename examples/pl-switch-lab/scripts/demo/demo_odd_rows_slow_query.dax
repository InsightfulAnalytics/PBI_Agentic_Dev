        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 12,
            CALCULATE ( [NM Trading Stores], 'Financials'[Scenario] = "Actual", DATESYTD ( 'DimDate'[Date] ) ) - CALCULATE ( [NM Trading Stores], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) )
    )

    MEASURE '00_Measures'[Slow NM YTD Var to Budget %] =
    SWITCH (
        TRUE ( ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 0,
            DIVIDE ( CALCULATE ( [NM Total Income], 'Financials'[Scenario] = "Actual", DATESYTD ( 'DimDate'[Date] ) ) - CALCULATE ( [NM Total Income], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ), CALCULATE ( [NM Total Income], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 1,
            DIVIDE ( CALCULATE ( [NM Total Cost of Sales], 'Financials'[Scenario] = "Actual", DATESYTD ( 'DimDate'[Date] ) ) - CALCULATE ( [NM Total Cost of Sales], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ), CALCULATE ( [NM Total Cost of Sales], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 2,
