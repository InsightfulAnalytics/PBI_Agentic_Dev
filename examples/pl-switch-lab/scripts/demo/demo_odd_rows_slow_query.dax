        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 6,
            CALCULATE ( [NM Net Margin %], 'Financials'[Scenario] = "Actual", DATESYTD ( 'DimDate'[Date] ) ) - CALCULATE ( [NM Net Margin %], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 7,
