        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 4,
            DIVIDE ( CALCULATE ( [NM Net Profit], 'Financials'[Scenario] = "Actual", DATESYTD ( 'DimDate'[Date] ) ) - CALCULATE ( [NM Net Profit], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ), CALCULATE ( [NM Net Profit], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 5,
            DIVIDE ( CALCULATE ( [NM Gross Margin %], 'Financials'[Scenario] = "Actual", DATESYTD ( 'DimDate'[Date] ) ) - CALCULATE ( [NM Gross Margin %], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ), CALCULATE ( [NM Gross Margin %], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 6,
            DIVIDE ( CALCULATE ( [NM Net Margin %], 'Financials'[Scenario] = "Actual", DATESYTD ( 'DimDate'[Date] ) ) - CALCULATE ( [NM Net Margin %], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ), CALCULATE ( [NM Net Margin %], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 7,
            DIVIDE ( CALCULATE ( [NM COGS % of Income], 'Financials'[Scenario] = "Actual", DATESYTD ( 'DimDate'[Date] ) ) - CALCULATE ( [NM COGS % of Income], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ), CALCULATE ( [NM COGS % of Income], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 8,
            DIVIDE ( CALCULATE ( [NM Opex % of Income], 'Financials'[Scenario] = "Actual", DATESYTD ( 'DimDate'[Date] ) ) - CALCULATE ( [NM Opex % of Income], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ), CALCULATE ( [NM Opex % of Income], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 9,
            DIVIDE ( CALCULATE ( [NM Income per Trading Store], 'Financials'[Scenario] = "Actual", DATESYTD ( 'DimDate'[Date] ) ) - CALCULATE ( [NM Income per Trading Store], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ), CALCULATE ( [NM Income per Trading Store], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 10,
            DIVIDE ( CALCULATE ( [NM Net Profit per Trading Store], 'Financials'[Scenario] = "Actual", DATESYTD ( 'DimDate'[Date] ) ) - CALCULATE ( [NM Net Profit per Trading Store], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ), CALCULATE ( [NM Net Profit per Trading Store], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 11,
            DIVIDE ( CALCULATE ( [NM Income per Active Product], 'Financials'[Scenario] = "Actual", DATESYTD ( 'DimDate'[Date] ) ) - CALCULATE ( [NM Income per Active Product], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ), CALCULATE ( [NM Income per Active Product], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 12,
            DIVIDE ( CALCULATE ( [NM Trading Stores], 'Financials'[Scenario] = "Actual", DATESYTD ( 'DimDate'[Date] ) ) - CALCULATE ( [NM Trading Stores], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ), CALCULATE ( [NM Trading Stores], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ) )
    )

EVALUATE
SUMMARIZECOLUMNS (
    'P&L Odd Rows Fields'[Odd Rows Line Order],
    __Yr,

    "Actual", [Slow NM Actual],
    "LY", [Slow NM LY],
    "vs LY", [Slow NM vs LY],
    "vs LY %", [Slow NM vs LY %],
    "Budget", [Slow NM Budget],
    "Var to Budget", [Slow NM Var to Budget],
