// demo_odd_rows_slow_query.dax -- the SAME 182-cell grid as demo_odd_rows_query.dax,
// built the classic way: 14 measures, each a 13-branch SWITCH(TRUE()) on the row ordinal
// (the field parameter's label column is a composite key, so the ordinal is the join key).
//
// Deliberately GENEROUS to the SWITCH side: every branch calls the same efficient
// scenario-agnostic [NM ...] leaf measures the fast version uses. The ONLY difference
// between the two files is how a cell is dispatched -- SWITCH branching vs a field
// parameter + calculation group. That isolates the variable exactly.
//
// Query-scoped on purpose: this costs the shipped model nothing.
// Run: scripts\time_query.ps1 -QueryFile "scripts\demo\demo_odd_rows_slow_query.dax"

DEFINE
    VAR __Yr = TREATAS ( { 2026 }, 'DimDate'[Year] )

    MEASURE '00_Measures'[Slow NM Actual] =
    SWITCH (
        TRUE ( ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 0,
            CALCULATE ( [NM Total Income], 'Financials'[Scenario] = "Actual" ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 1,
            CALCULATE ( [NM Total Cost of Sales], 'Financials'[Scenario] = "Actual" ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 2,
            CALCULATE ( [NM Gross Profit], 'Financials'[Scenario] = "Actual" ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 3,
            CALCULATE ( [NM Total Operating Expenses], 'Financials'[Scenario] = "Actual" ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 4,
            CALCULATE ( [NM Net Profit], 'Financials'[Scenario] = "Actual" ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 5,
            CALCULATE ( [NM Gross Margin %], 'Financials'[Scenario] = "Actual" ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 6,
            CALCULATE ( [NM Net Margin %], 'Financials'[Scenario] = "Actual" ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 7,
            CALCULATE ( [NM COGS % of Income], 'Financials'[Scenario] = "Actual" ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 8,
            CALCULATE ( [NM Opex % of Income], 'Financials'[Scenario] = "Actual" ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 9,
            CALCULATE ( [NM Income per Trading Store], 'Financials'[Scenario] = "Actual" ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 10,
            CALCULATE ( [NM Net Profit per Trading Store], 'Financials'[Scenario] = "Actual" ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 11,
            CALCULATE ( [NM Income per Active Product], 'Financials'[Scenario] = "Actual" ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 12,
            CALCULATE ( [NM Trading Stores], 'Financials'[Scenario] = "Actual" )
    )

    MEASURE '00_Measures'[Slow NM LY] =
    SWITCH (
        TRUE ( ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 0,
            CALCULATE ( CALCULATE ( [NM Total Income], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 1,
            CALCULATE ( CALCULATE ( [NM Total Cost of Sales], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 2,
            CALCULATE ( CALCULATE ( [NM Gross Profit], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 3,
            CALCULATE ( CALCULATE ( [NM Total Operating Expenses], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 4,
            CALCULATE ( CALCULATE ( [NM Net Profit], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 5,
            CALCULATE ( CALCULATE ( [NM Gross Margin %], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 6,
            CALCULATE ( CALCULATE ( [NM Net Margin %], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 7,
            CALCULATE ( CALCULATE ( [NM COGS % of Income], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 8,
            CALCULATE ( CALCULATE ( [NM Opex % of Income], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 9,
            CALCULATE ( CALCULATE ( [NM Income per Trading Store], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 10,
            CALCULATE ( CALCULATE ( [NM Net Profit per Trading Store], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 11,
            CALCULATE ( CALCULATE ( [NM Income per Active Product], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 12,
            CALCULATE ( CALCULATE ( [NM Trading Stores], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) )
    )

    MEASURE '00_Measures'[Slow NM vs LY] =
    SWITCH (
        TRUE ( ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 0,
            CALCULATE ( [NM Total Income], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( CALCULATE ( [NM Total Income], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 1,
            CALCULATE ( [NM Total Cost of Sales], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( CALCULATE ( [NM Total Cost of Sales], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 2,
            CALCULATE ( [NM Gross Profit], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( CALCULATE ( [NM Gross Profit], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 3,
            CALCULATE ( [NM Total Operating Expenses], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( CALCULATE ( [NM Total Operating Expenses], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 4,
            CALCULATE ( [NM Net Profit], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( CALCULATE ( [NM Net Profit], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 5,
            CALCULATE ( [NM Gross Margin %], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( CALCULATE ( [NM Gross Margin %], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 6,
            CALCULATE ( [NM Net Margin %], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( CALCULATE ( [NM Net Margin %], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 7,
            CALCULATE ( [NM COGS % of Income], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( CALCULATE ( [NM COGS % of Income], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 8,
            CALCULATE ( [NM Opex % of Income], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( CALCULATE ( [NM Opex % of Income], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 9,
            CALCULATE ( [NM Income per Trading Store], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( CALCULATE ( [NM Income per Trading Store], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 10,
            CALCULATE ( [NM Net Profit per Trading Store], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( CALCULATE ( [NM Net Profit per Trading Store], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 11,
            CALCULATE ( [NM Income per Active Product], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( CALCULATE ( [NM Income per Active Product], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 12,
            CALCULATE ( [NM Trading Stores], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( CALCULATE ( [NM Trading Stores], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) )
    )

    MEASURE '00_Measures'[Slow NM vs LY %] =
    SWITCH (
        TRUE ( ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 0,
            DIVIDE ( CALCULATE ( [NM Total Income], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( CALCULATE ( [NM Total Income], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ), CALCULATE ( CALCULATE ( [NM Total Income], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 1,
            DIVIDE ( CALCULATE ( [NM Total Cost of Sales], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( CALCULATE ( [NM Total Cost of Sales], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ), CALCULATE ( CALCULATE ( [NM Total Cost of Sales], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 2,
            DIVIDE ( CALCULATE ( [NM Gross Profit], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( CALCULATE ( [NM Gross Profit], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ), CALCULATE ( CALCULATE ( [NM Gross Profit], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 3,
            DIVIDE ( CALCULATE ( [NM Total Operating Expenses], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( CALCULATE ( [NM Total Operating Expenses], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ), CALCULATE ( CALCULATE ( [NM Total Operating Expenses], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 4,
            DIVIDE ( CALCULATE ( [NM Net Profit], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( CALCULATE ( [NM Net Profit], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ), CALCULATE ( CALCULATE ( [NM Net Profit], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 5,
            DIVIDE ( CALCULATE ( [NM Gross Margin %], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( CALCULATE ( [NM Gross Margin %], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ), CALCULATE ( CALCULATE ( [NM Gross Margin %], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 6,
            DIVIDE ( CALCULATE ( [NM Net Margin %], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( CALCULATE ( [NM Net Margin %], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ), CALCULATE ( CALCULATE ( [NM Net Margin %], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 7,
            DIVIDE ( CALCULATE ( [NM COGS % of Income], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( CALCULATE ( [NM COGS % of Income], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ), CALCULATE ( CALCULATE ( [NM COGS % of Income], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 8,
            DIVIDE ( CALCULATE ( [NM Opex % of Income], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( CALCULATE ( [NM Opex % of Income], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ), CALCULATE ( CALCULATE ( [NM Opex % of Income], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 9,
            DIVIDE ( CALCULATE ( [NM Income per Trading Store], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( CALCULATE ( [NM Income per Trading Store], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ), CALCULATE ( CALCULATE ( [NM Income per Trading Store], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 10,
            DIVIDE ( CALCULATE ( [NM Net Profit per Trading Store], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( CALCULATE ( [NM Net Profit per Trading Store], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ), CALCULATE ( CALCULATE ( [NM Net Profit per Trading Store], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 11,
            DIVIDE ( CALCULATE ( [NM Income per Active Product], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( CALCULATE ( [NM Income per Active Product], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ), CALCULATE ( CALCULATE ( [NM Income per Active Product], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 12,
            DIVIDE ( CALCULATE ( [NM Trading Stores], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( CALCULATE ( [NM Trading Stores], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ), CALCULATE ( CALCULATE ( [NM Trading Stores], 'Financials'[Scenario] = "Actual" ), DATEADD ( 'DimDate'[Date], -1, YEAR ) ) )
    )

    MEASURE '00_Measures'[Slow NM Budget] =
    SWITCH (
        TRUE ( ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 0,
            CALCULATE ( [NM Total Income], 'Financials'[Scenario] = "Budget" ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 1,
            CALCULATE ( [NM Total Cost of Sales], 'Financials'[Scenario] = "Budget" ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 2,
            CALCULATE ( [NM Gross Profit], 'Financials'[Scenario] = "Budget" ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 3,
            CALCULATE ( [NM Total Operating Expenses], 'Financials'[Scenario] = "Budget" ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 4,
            CALCULATE ( [NM Net Profit], 'Financials'[Scenario] = "Budget" ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 5,
            CALCULATE ( [NM Gross Margin %], 'Financials'[Scenario] = "Budget" ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 6,
            CALCULATE ( [NM Net Margin %], 'Financials'[Scenario] = "Budget" ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 7,
            CALCULATE ( [NM COGS % of Income], 'Financials'[Scenario] = "Budget" ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 8,
            CALCULATE ( [NM Opex % of Income], 'Financials'[Scenario] = "Budget" ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 9,
            CALCULATE ( [NM Income per Trading Store], 'Financials'[Scenario] = "Budget" ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 10,
            CALCULATE ( [NM Net Profit per Trading Store], 'Financials'[Scenario] = "Budget" ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 11,
            CALCULATE ( [NM Income per Active Product], 'Financials'[Scenario] = "Budget" ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 12,
            CALCULATE ( [NM Trading Stores], 'Financials'[Scenario] = "Budget" )
    )

    MEASURE '00_Measures'[Slow NM Var to Budget] =
    SWITCH (
        TRUE ( ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 0,
            CALCULATE ( [NM Total Income], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( [NM Total Income], 'Financials'[Scenario] = "Budget" ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 1,
            CALCULATE ( [NM Total Cost of Sales], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( [NM Total Cost of Sales], 'Financials'[Scenario] = "Budget" ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 2,
            CALCULATE ( [NM Gross Profit], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( [NM Gross Profit], 'Financials'[Scenario] = "Budget" ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 3,
            CALCULATE ( [NM Total Operating Expenses], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( [NM Total Operating Expenses], 'Financials'[Scenario] = "Budget" ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 4,
            CALCULATE ( [NM Net Profit], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( [NM Net Profit], 'Financials'[Scenario] = "Budget" ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 5,
            CALCULATE ( [NM Gross Margin %], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( [NM Gross Margin %], 'Financials'[Scenario] = "Budget" ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 6,
            CALCULATE ( [NM Net Margin %], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( [NM Net Margin %], 'Financials'[Scenario] = "Budget" ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 7,
            CALCULATE ( [NM COGS % of Income], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( [NM COGS % of Income], 'Financials'[Scenario] = "Budget" ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 8,
            CALCULATE ( [NM Opex % of Income], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( [NM Opex % of Income], 'Financials'[Scenario] = "Budget" ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 9,
            CALCULATE ( [NM Income per Trading Store], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( [NM Income per Trading Store], 'Financials'[Scenario] = "Budget" ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 10,
            CALCULATE ( [NM Net Profit per Trading Store], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( [NM Net Profit per Trading Store], 'Financials'[Scenario] = "Budget" ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 11,
            CALCULATE ( [NM Income per Active Product], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( [NM Income per Active Product], 'Financials'[Scenario] = "Budget" ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 12,
            CALCULATE ( [NM Trading Stores], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( [NM Trading Stores], 'Financials'[Scenario] = "Budget" )
    )

    MEASURE '00_Measures'[Slow NM Var to Budget %] =
    SWITCH (
        TRUE ( ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 0,
            DIVIDE ( CALCULATE ( [NM Total Income], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( [NM Total Income], 'Financials'[Scenario] = "Budget" ), CALCULATE ( [NM Total Income], 'Financials'[Scenario] = "Budget" ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 1,
            DIVIDE ( CALCULATE ( [NM Total Cost of Sales], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( [NM Total Cost of Sales], 'Financials'[Scenario] = "Budget" ), CALCULATE ( [NM Total Cost of Sales], 'Financials'[Scenario] = "Budget" ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 2,
            DIVIDE ( CALCULATE ( [NM Gross Profit], 'Financials'[Scenario] = "Actual" ) - CALCULATE ( [NM Gross Profit], 'Financials'[Scenario] = "Budget" ), CALCULATE ( [NM Gross Profit], 'Financials'[Scenario] = "Budget" ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 3,
