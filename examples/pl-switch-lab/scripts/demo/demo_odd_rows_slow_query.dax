            CALCULATE ( [NM Gross Margin %], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 6,
            CALCULATE ( [NM Net Margin %], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 7,
            CALCULATE ( [NM COGS % of Income], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 8,
            CALCULATE ( [NM Opex % of Income], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 9,
