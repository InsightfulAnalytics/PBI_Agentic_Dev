        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 8,
            CALCULATE ( [NM Opex % of Income], 'Financials'[Scenario] = "Actual", DATESYTD ( 'DimDate'[Date] ) ) - CALCULATE ( [NM Opex % of Income], 'Financials'[Scenario] = "Budget", DATESYTD ( 'DimDate'[Date] ) ),
        SELECTEDVALUE ( 'P&L Odd Rows Fields'[Odd Rows Line Order] ) = 9,
