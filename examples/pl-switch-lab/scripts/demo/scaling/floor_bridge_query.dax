// FLOOR probe 2 (scratch): real per-row dispatch through the BRIDGE relationship,
// 14 calc-group columns. Rows here are the bridge's own statement lines, so the row
// axis costs real filter propagation -- the honest lower bound for any relationship-
// driven row axis at this column count.

DEFINE
    VAR __Yr = TREATAS ( { 2026 }, 'DimDate'[Year] )

EVALUATE
SUMMARIZECOLUMNS (
    'P&L Lines'[Line],
    __Yr,
    "Actual", CALCULATE ( [NM Amount], 'P&L View'[P&L View] = "Actual" ),
    "LY", CALCULATE ( [NM Amount], 'P&L View'[P&L View] = "LY" ),
    "vs LY", CALCULATE ( [NM Amount], 'P&L View'[P&L View] = "vs LY" ),
    "vs LY %", CALCULATE ( [NM Amount], 'P&L View'[P&L View] = "vs LY %" ),
    "Budget", CALCULATE ( [NM Amount], 'P&L View'[P&L View] = "Budget" ),
    "Var to Budget", CALCULATE ( [NM Amount], 'P&L View'[P&L View] = "Var to Budget" ),
    "Var to Budget %", CALCULATE ( [NM Amount], 'P&L View'[P&L View] = "Var to Budget %" ),
    "YTD Actual", CALCULATE ( [NM Amount], 'P&L View'[P&L View] = "YTD Actual" ),
    "YTD LY", CALCULATE ( [NM Amount], 'P&L View'[P&L View] = "YTD LY" ),
    "YTD vs LY", CALCULATE ( [NM Amount], 'P&L View'[P&L View] = "YTD vs LY" ),
    "YTD vs LY %", CALCULATE ( [NM Amount], 'P&L View'[P&L View] = "YTD vs LY %" ),
    "YTD Budget", CALCULATE ( [NM Amount], 'P&L View'[P&L View] = "YTD Budget" ),
    "YTD Var to Budget", CALCULATE ( [NM Amount], 'P&L View'[P&L View] = "YTD Var to Budget" ),
    "YTD Var to Budget %", CALCULATE ( [NM Amount], 'P&L View'[P&L View] = "YTD Var to Budget %" )
)
