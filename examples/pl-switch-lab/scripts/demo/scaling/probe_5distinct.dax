// SCRATCH probe. 5 DISTINCT bridge filters x 14 calc items. Compare to _probe_5rows (the real NM measures,
// same 5 lines) to confirm measure indirection costs nothing.

DEFINE
    VAR __Yr = TREATAS ( { 2026 }, 'DimDate'[Year] )

EVALUATE
SUMMARIZECOLUMNS (
    'P&L View'[P&L View],
    'P&L View'[Ordinal],
    __Yr,
    "Total Income", CALCULATE ( [NM Amount], 'P&L Lines'[Line] = "Total Income" ),
    "Total Cost of Sales", CALCULATE ( [NM Amount], 'P&L Lines'[Line] = "Total Cost of Sales" ),
    "Gross Profit", CALCULATE ( [NM Amount], 'P&L Lines'[Line] = "Gross Profit" ),
    "Total Operating Expenses", CALCULATE ( [NM Amount], 'P&L Lines'[Line] = "Total Operating Expenses" ),
    "Net Profit", CALCULATE ( [NM Amount], 'P&L Lines'[Line] = "Net Profit" )
)
ORDER BY 'P&L View'[Ordinal]
