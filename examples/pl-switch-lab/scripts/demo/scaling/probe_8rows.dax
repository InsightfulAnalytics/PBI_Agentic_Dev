// SCRATCH probe. Same 14-item calc-group axis as page 6, but the 13 measure columns
// are replaced by only the 8 ratio / DISTINCTCOUNT NM rows. Isolates WHY page 6 costs ~1,020 ms warm when the
// bare calc-group axis costs 29 ms: is it the CELL COUNT (182 independent evaluations)
// or the EXPRESSION DEPTH of the 13 NM measures?

DEFINE
    VAR __Yr = TREATAS ( { 2026 }, 'DimDate'[Year] )

EVALUATE
SUMMARIZECOLUMNS (
    'P&L View'[P&L View],
    'P&L View'[Ordinal],
    __Yr,
    "Gross Margin %", [NM Gross Margin %],
    "Net Margin %", [NM Net Margin %],
    "COGS % of Income", [NM COGS % of Income],
    "Opex % of Income", [NM Opex % of Income],
    "Income per Trading Store", [NM Income per Trading Store],
    "Net Profit per Trading Store", [NM Net Profit per Trading Store],
    "Income per Active Product", [NM Income per Active Product],
    "Trading Stores", [NM Trading Stores]
)
ORDER BY 'P&L View'[Ordinal]
