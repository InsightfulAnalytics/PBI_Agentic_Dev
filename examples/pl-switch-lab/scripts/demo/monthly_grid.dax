// Generated by scripts/demo/gen_monthly_queries.py -- edit that, not this.
// Filter context pinned to match the page: Year = 2026, no other slicer selections.
// The whole grid, as far as the engine is concerned: 12 rows x 10 base measures.
// MonthOffset is aggregated, not grouped -- see docs/performance/05-case-unrenderable-matrix.md.

EVALUATE
CALCULATETABLE (
    SUMMARIZECOLUMNS (
        'DimDate'[Year],
        'DimDate'[MonthOfYear],
        "MonthOffset", MIN ( 'DimDate'[MonthOffset] ),
        "IncAct", [MP Income Act],
        "IncLY", [MP Income LY],
        "CogAct", [MP COGS Act],
        "CogLY", [MP COGS LY],
        "GPAct", [MP GP Act],
        "GPLY", [MP GP LY],
        "OpxAct", [MP Opex Act],
        "OpxLY", [MP Opex LY],
        "NPAct", [MP NP Act],
        "NPLY", [MP NP LY]
    ),
    'DimDate'[Year] = 2026
)
ORDER BY 'DimDate'[MonthOfYear]
