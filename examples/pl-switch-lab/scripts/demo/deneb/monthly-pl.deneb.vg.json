        {
          "type": "formula",
          "as": "NPAct",
          "expr": "datum.vNPAct > 0 ? datum.sNPAct : null"
        },
        {
          "type": "formula",
          "as": "NPLY",
          "expr": "datum.vNPLY > 0 ? datum.sNPLY : null"
        },
        {
          "type": "formula",
          "as": "curP",
          "expr": "isFinite(datum.todayIdx) ? ((datum.todayIdx - 1) % 12) + 1 : null"
        }
      ]
    },
    {
      "name": "monthCols",
      "source": "months",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.Month >= 1 && datum.Month <= 12"
        },
        {
          "type": "formula",
          "as": "colIdx",
          "expr": "datum.Month - 1"
        },
        {
          "type": "formula",
          "as": "colLabel",
          "expr": "[\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\", \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"][datum.Month - 1]"
