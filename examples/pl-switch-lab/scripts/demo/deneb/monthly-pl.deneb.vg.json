          "as": "colIdx",
          "expr": "14"
        }
      ]
    },
    {
      "name": "cells",
      "source": [
        "monthCols",
        "totYTD",
        "totYTG",
        "totFY"
      ],
      "transform": [
        {
          "type": "formula",
          "as": "inc_act",
          "expr": "datum.IncAct"
        },
        {
          "type": "formula",
          "as": "inc_ly",
          "expr": "datum.IncLY"
        },
        {
          "type": "formula",
          "as": "inc_var",
          "expr": "(datum.IncLY == null || datum.IncLY == 0) ? null : (((datum.IncAct == null ? 0 : datum.IncAct) - datum.IncLY) / datum.IncLY)"
        },
        {
          "type": "formula",
          "as": "cog_act",
          "expr": "datum.CogAct"
        },
        {
          "type": "formula",
          "as": "cog_ly",
          "expr": "datum.CogLY"
        },
        {
          "type": "formula",
          "as": "cog_var",
          "expr": "(datum.CogLY == null || datum.CogLY == 0) ? null : (((datum.CogAct == null ? 0 : datum.CogAct) - datum.CogLY) / datum.CogLY)"
        },
        {
          "type": "formula",
          "as": "gp_act",
          "expr": "datum.GPAct"
        },
        {
          "type": "formula",
          "as": "gp_ly",
          "expr": "datum.GPLY"
        },
        {
          "type": "formula",
          "as": "gp_var",
          "expr": "(datum.GPLY == null || datum.GPLY == 0) ? null : (((datum.GPAct == null ? 0 : datum.GPAct) - datum.GPLY) / datum.GPLY)"
        },
        {
          "type": "formula",
          "as": "gm_act",
          "expr": "(datum.IncAct == null || datum.IncAct == 0 || datum.GPAct == null) ? null : (datum.GPAct / datum.IncAct)"
        },
        {
          "type": "formula",
          "as": "gm_ly",
          "expr": "(datum.IncLY == null || datum.IncLY == 0 || datum.GPLY == null) ? null : (datum.GPLY / datum.IncLY)"
        },
        {
          "type": "formula",
          "as": "gm_var",
          "expr": "(datum.gm_act == null && datum.gm_ly == null) ? null : ((datum.gm_act == null ? 0 : datum.gm_act) - (datum.gm_ly == null ? 0 : datum.gm_ly))"
        },
        {
          "type": "formula",
          "as": "opx_act",
          "expr": "datum.OpxAct"
        },
        {
          "type": "formula",
          "as": "opx_ly",
          "expr": "datum.OpxLY"
        },
        {
          "type": "formula",
          "as": "opx_var",
          "expr": "(datum.OpxLY == null || datum.OpxLY == 0) ? null : (((datum.OpxAct == null ? 0 : datum.OpxAct) - datum.OpxLY) / datum.OpxLY)"
        },
        {
          "type": "formula",
          "as": "opr_act",
          "expr": "(datum.IncAct == null || datum.IncAct == 0 || datum.OpxAct == null) ? null : (-datum.OpxAct / datum.IncAct)"
        },
        {
          "type": "formula",
          "as": "opr_ly",
          "expr": "(datum.IncLY == null || datum.IncLY == 0 || datum.OpxLY == null) ? null : (-datum.OpxLY / datum.IncLY)"
        },
        {
          "type": "formula",
          "as": "opr_var",
          "expr": "(datum.opr_act == null && datum.opr_ly == null) ? null : ((datum.opr_act == null ? 0 : datum.opr_act) - (datum.opr_ly == null ? 0 : datum.opr_ly))"
        },
        {
          "type": "formula",
          "as": "np_act",
          "expr": "datum.NPAct"
        },
        {
          "type": "formula",
          "as": "np_ly",
          "expr": "datum.NPLY"
        },
        {
          "type": "formula",
          "as": "np_var",
          "expr": "(datum.NPLY == null || datum.NPLY == 0) ? null : (((datum.NPAct == null ? 0 : datum.NPAct) - datum.NPLY) / datum.NPLY)"
        },
        {
          "type": "fold",
          "fields": [
            "inc_act",
            "inc_ly",
            "inc_var",
            "cog_act",
            "cog_ly",
            "cog_var",
            "gp_act",
            "gp_ly",
            "gp_var",
            "gm_act",
            "gm_ly",
            "gm_var",
            "opx_act",
            "opx_ly",
            "opx_var",
            "opr_act",
            "opr_ly",
            "opr_var",
            "np_act",
            "np_ly",
            "np_var"
          ],
          "as": [
            "key",
            "value"
          ]
        },
        {
          "type": "lookup",
          "from": "rowsReg",
          "key": "key",
          "fields": [
            "key"
          ],
          "values": [
            "rowIdx",
            "label",
            "fmt",
            "isVar"
          ],
          "as": [
            "rowIdx",
            "rowLabel",
            "fmt",
            "isVar"
          ]
        },
        {
          "type": "formula",
          "as": "av",
          "expr": "abs(datum.value)"
        },
        {
          "type": "formula",
          "as": "body",
          "expr": "datum.fmt == 'pct' ? (datum.av >= 1 ? format(datum.av, '.0%') : format(datum.av, '.1%')) : '$' + (datum.av >= 999950 ? format(datum.av / 1e6, ',.1f') + 'M' : datum.av >= 999.5 ? format(datum.av / 1e3, ',.1f') + 'K' : format(datum.av, ',.0f'))"
        },
        {
          "type": "formula",
          "as": "fmtd",
          "expr": "datum.value == null ? '' : (datum.value < 0 ? '(' + datum.body + ')' : datum.body)"
        }
      ]
    }
  ],
  "marks": [
    {
      "type": "rect",
      "name": "headerBand",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "value": 0
          },
          "x2": {
            "signal": "width"
          },
          "y": {
            "value": 0
          },
          "y2": {
            "signal": "headerHeight"
          },
          "fill": {
            "value": "#1B3A57"
          }
        }
      }
    },
    {
      "type": "text",
      "name": "headerLabels",
      "from": {
        "data": "colsReg"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "labelWidth + (datum.colIdx + 0.5) * colWidth"
          },
          "y": {
            "signal": "headerHeight / 2"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "text": {
            "field": "colLabel"
          },
          "font": {
            "value": "Segoe UI"
          },
          "fontSize": {
            "value": 13
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#FFFFFF"
          }
        }
      }
    },
    {
      "type": "rect",
      "name": "titleBands",
      "from": {
        "data": "titleRows"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "value": 0
          },
          "x2": {
            "signal": "width"
          },
          "y": {
            "signal": "headerHeight + datum.rowIdx * rowHeight"
          },
          "height": {
            "signal": "rowHeight"
          },
          "fill": {
            "value": "#F1F1F1"
          }
        }
      }
    },
    {
      "type": "rule",
      "name": "gridRules",
      "from": {
        "data": "rowEdges"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "value": 0
          },
          "x2": {
            "signal": "width"
          },
          "y": {
            "signal": "min(headerHeight + datum.edge * rowHeight, height - 0.5)"
          },
          "stroke": {
            "value": "#E6E6E6"
          },
          "strokeWidth": {
            "value": 1
          }
        }
      }
    },
    {
      "type": "text",
      "name": "rowLabels",
      "from": {
        "data": "rowsReg"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "datum.kind == 'title' ? 10 : 24"
          },
          "y": {
            "signal": "headerHeight + (datum.rowIdx + 0.5) * rowHeight"
          },
          "baseline": {
            "value": "middle"
          },
          "text": {
            "field": "label"
          },
          "font": {
            "value": "Segoe UI"
          },
          "fontSize": {
            "value": 13
          },
          "fontWeight": {
            "signal": "datum.kind == 'title' ? 'bold' : 'normal'"
          },
          "fill": {
            "value": "#231F20"
          },
          "limit": {
            "signal": "labelWidth - (datum.kind == 'title' ? 10 : 24) - 6"
          }
        }
      }
    },
    {
      "type": "text",
      "name": "cellText",
      "from": {
        "data": "cells"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "labelWidth + (datum.colIdx + 1) * colWidth - 6"
          },
          "y": {
            "signal": "headerHeight + (datum.rowIdx + 0.5) * rowHeight"
          },
          "align": {
            "value": "right"
          },
          "baseline": {
            "value": "middle"
          },
          "text": {
            "field": "fmtd"
          },
          "font": {
            "value": "Segoe UI"
          },
          "fontSize": {
            "value": 13
          },
          "fill": {
            "signal": "datum.isVar && datum.value != null && datum.value != 0 ? (datum.value > 0 ? '#00792E' : '#B3261E') : '#231F20'"
          },
          "limit": {
            "signal": "colWidth - 8"
          },
          "tooltip": {
            "signal": "{'Line': datum.rowLabel, 'Column': datum.colLabel, 'Value': datum.fmtd == '' ? '\u2014' : datum.fmtd}"
          }
        }
      }
    }
  ]
}