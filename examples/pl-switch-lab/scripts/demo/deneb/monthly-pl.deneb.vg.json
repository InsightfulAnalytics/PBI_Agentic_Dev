{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Monthly P&L grid - one flat query, calculation group replaced by spec-side derivation",
  "background": "#FFFFFF",
  "padding": 0,
  "autosize": {
    "type": "none",
    "resize": true
  },
  "width": {
    "signal": "pbiContainerWidth - (pbiContainerHeight < 622 ? 12 : 0)"
  },
  "height": {
    "signal": "max(pbiContainerHeight, 622)"
  },
  "signals": [
    {
      "name": "headerHeight",
      "value": 34
    },
    {
      "name": "labelWidth",
      "value": 160
    },
    {
      "name": "colWidth",
      "update": "(width - labelWidth) / 15"
    },
    {
      "name": "rowHeight",
      "update": "(height - headerHeight) / 28"
    }
  ],
  "data": [
    {
      "name": "dataset",
      "transform": [
        {
          "type": "formula",
          "as": "todayIdx",
          "expr": "isValid(datum.MonthOffset) && isValid(datum.Year) && isValid(datum.Month) ? 12 * datum.Year + datum.Month - datum.MonthOffset : null"
        }
      ]
    },
