            "vNPAct",
            "vNPLY",
            "todayIdx"
          ],
          "groupby": [
            "Month"
          ]
        },
        {
          "type": "formula",
          "as": "IncAct",
          "expr": "datum.vIncAct > 0 ? datum.sIncAct : null"
