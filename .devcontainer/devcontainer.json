{
  "name": "power-bi-agentic-dev",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "postCreateCommand": "npm install -g @anthropic-ai/claude-code && bash scripts/bootstrap-agent-env.sh",
  "postStartCommand": "bash scripts/bootstrap-agent-env.sh --refresh",

  "remoteEnv": {
    "PBI_MARKETPLACE_ROOT": "${containerWorkspaceFolder}",
    "PYTHONIOENCODING": "utf-8",
    "PYTHONUTF8": "1"
  },

  "customizations": {
    "vscode": {
      "extensions": ["anthropic.claude-code", "ms-python.python"]
    }
  }
}
